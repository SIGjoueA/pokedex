{"id":766,"gn":"Pokémon Coopération","ft":["Ils se rassemblent par groupes de vingt. Dans cette formation très soudée, nul ne songerait une seule seconde à abandonner ses alliés.","Il choisit les Baies les plus dures pour s’en servir au combat : un stratagème bien rodé que les chefs de groupe enseignent à leurs alliés.","Il utilise sa salive pour coller des feuilles sur ses épaules. Leur disposition indique son appartenance à un groupe particulier.","Les Baies constituent à la fois son arme et la base de son alimentation. Celui qui peut les lancer le plus loin devient le chef du groupe.","Ils obéissent à leur chef au doigt et à l’œil, et travaillent en équipe pour dénicher leurs Baies favorites.","Ils vivent en groupes de vingt individus où chacun a un rôle précis, ce qui leur a permis de survivre dans un environnement impitoyable."],"fv":{"27":0,"28":1,"29":2,"30":3,"33":4,"34":5},"gr":4,"cr":45,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"slow","gm":{"sv":[0,314],"swisle":[0,90],"sw":[0,343],"usum":[0,216],"usum*":[1,117],"sm":[0,177],"sm*":[1,104]},"f":{"766":{"n":"Quartermac","t":["fighting"],"s":[100,120,90,40,60,80],"h":2,"w":82.8,"a":[[222,0],[128,1]],"av":["sv","swisle","sw","usum","sm"],"ls":[{"l":[[33,1],[43,1],[249,5],[116,10],[251,15],[184,20],[36,25],[374,30],[339,35],[37,40],[38,45],[370,50],[179,55],[416,60]],"m":[34,36,38,63,67,89,156,157,164,168,174,179,182,184,203,214,220,226,240,241,247,253,263,264,269,280,282,317,339,360,369,370,374,402,409,410,411,412,416,441,442,447,479,490,512,523,527,811,851,885,886,918],"e":[68,69,98,282,364,501]},{"l":[[33,1],[43,1],[249,5],[116,10],[251,15],[184,20],[36,25],[374,30],[339,35],[37,40],[38,45],[370,50],[179,55],[416,60]],"m":[5,25,63,89,116,156,157,164,168,173,179,182,184,203,213,214,231,240,241,247,251,253,263,269,276,279,280,317,339,360,369,370,371,372,374,402,409,411,412,416,441,442,447,490,496,512,514,523,526,527,693],"e":[68,69,98,233,282,364,501],"t":[811]},{"l":[[33,1],[43,4],[249,8],[116,11],[251,15],[184