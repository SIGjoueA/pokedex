{"id":257,"gn":"Pokémon Ardent","ft":["Des flammes fusent de ses poignets et ses coups brûlent l’ennemi.","Il peut bondir par-dessus un bâtiment de 30 étages. Ses poings enflammés brûlent ses adversaires.","Quand il est face à un ennemi, il laisse s’échapper des gerbes de flammes par ses poignets. Ses jambes lui permettent de sauter par-dessus les immeubles.","Au combat, Braségali envoie des flammes ardentes de ses poignets. Il fait preuve d’un courage exceptionnel. Plus l’ennemi est puissant, plus les poignets de ce Pokémon sont ardents.","Braségali a des jambes incroyablement puissantes. Il peut sauter par-dessus un immeuble de trente étages. Les coups de poing enflammés de ce Pokémon peuvent carboniser ses ennemis."],"fv":{"17":0,"18":0,"23":1,"24":2,"25":3,"26":4},"gr":1,"cr":45,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"medium-slow","gm":{"zadlc":[0,44],"svdisk":[0,187],"sv":[2,187],"oras":[0,6],"e":[0,6],"rs":[0,6]},"f":{"257":{"n":"Braségali","t":["fire","fighting"],"s":[80,120,70,110,70,80],"h":1.9,"w":52,"a":[[66,0],[3,1]],"pa":[[4,[[66,0]]]],"av":["zadlc","svdisk","sv","oras","e","rs"],"ls":[{"l":[[299,0],[10,1],[24,1],[45,1],[98,1],[488,9],[197,12],[28,15],[332,20],[163,25],[340,30],[116,35],[339,42],[179,49],[394,56],[413,63]],"m":[7,9,14,34,36,38,46,53,63,67,76,83,89,91,97,126,129,156,157,164,168,174,179,182,189,203,214,226,241,253,257,261,263,264,270,280,282,297,307,315,317,332,339,369,370,374,394,396,398,410,411,413,416,421,444,488,490,512,519,523,535,811,815,851,915,918],"e":[7,52,53,64,68,297,306,364,387,400]},{"l":[[394,1],[7,1],[136,1],[10,1],[45,1],[52,1],[28,1],[52,5],[28,10],[64,14],[24,16],[488,20],[98,25],[339,31],[299,36],[116,37],[163,44],[413,50],[327,57],[394,63]],"m":[14,15,46,53,63,70,76,89,91,92,104,126,156,157,164,182,207,213,214,216,218,237,241,249,261,263,280,290,315,317,332,339,374,398,411,416,421,444,468,488,490,496,497,510,512,523,590,612],"t":[7,9,67,173,257,264,270,272,276,282,307,340,387,519,530]},{"l":[[7,1],[10,1],[45,1],[116,