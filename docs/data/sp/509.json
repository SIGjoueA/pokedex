{"id":509,"gn":"Pokémon Scélérat","ft":["Il vole les gens pour le plaisir, mais il est tellement mignon que ses victimes finissent toujours par lui pardonner.","Il détourne l’attention de ses victimes avec ses gestes mignons pour mieux les détrousser. En colère, il griffe.","Il vole les biens des personnes rien que pour voir leur visage désemparé. Son plus grand rival est Goupilou.","Malheur à qui se laisse berner par ses gestes adorables : une fois les gens à sa portée, il les griffe sans crier gare, en ricanant."],"fv":{"17":0,"18":1,"23":1,"24":0,"25":1,"26":0,"33":2,"34":3},"gr":4,"cr":255,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"medium","gm":{"zadlc":[0,53],"sw":[0,44],"xy":[2,42],"b2w2":[0,12],"bw":[0,15]},"f":{"509":{"n":"Chacripan","t":["dark"],"s":[41,50,37,50,37,66],"h":0.4,"w":10.1,"a":[[7,0],[84,0],[158,1]],"av":["zadlc","sw","xy","b2w2","bw"],"ls":[{"l":[[10,1],[45,1],[28,4],[252,5],[154,12],[259,16],[372,21],[468,24],[389,28],[417,32],[400,36],[583,40]],"m":[6,86,103,129,156,164,168,173,182,203,204,213,214,226,227,231,240,241,247,263,269,271,304,313,369,371,372,399,402,417,421,441,447,492,496,555,583],"e":[98,104,163,281,343,383],"t":[808]},{"l":[[10,1],[45,3],[274,6],[28,10],[154,12],[228,15],[259,19],[252,21],[468,24],[372,28],[163,30],[445,33],[400,37],[289,39],[417,42],[389,46],[583,49]],"m":[15,86,92,104,138,156,164,168,182,207,213,214,216,218,237,240,241,244,247,259,263,269,332,369,371,373,399,421,447,468,496,497,555,590],"e":[6,185,204,227,281,313,343,383,492]},{"l":[[10,1],[45,3],[274,6],[28,10],[154,12],[228,15],[259,19],[252,21],[468,24],[372,28],[163,30],[445,33],[400,37],[289,39],[417,42],[389,46]],"m":[15,86,92,104,138,156,164,168,182,207,213,216,218,237,240,241,244,247,259,263,269,332,369,371,373,421,447,468,496,497,555],"e":[6,185,204,227,281,313,343,492],"t":[173,180,214,231,271,272,282,289,304,343,399,402,441,492]},{"l":[[10,1],[45,3],[274,6],[28,10],[154,12],[228,15],[259,19],[252,21],[468,24],[372,28],[163,30],[445,33],[400,37],[289,