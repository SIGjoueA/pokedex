{"id":770,"gn":"Pokémon Châtod’Sable","ft":["Il a possédé un humain pour que ce dernier le remodèle en château de sable, décuplant au passage ses pouvoirs de malédiction.","On trouve de nombreux ossements sous ses tours, restes de pauvres hères capturés. Leur énergie a servi à nourrir ce Pokémon.","Chacun de ses grains de sable a sa volonté propre. Trépassable gobe de petits Pokémon pour absorber leur énergie vitale.","Ce terrifiant Pokémon déclenche des tempêtes de sable pour immobiliser ses victimes, puis absorbe leur énergie vitale.","On l’appelle aussi le « cauchemar des plages ». Il contrôle le sable pour ensevelir ses proies et aspirer leur âme.","Bien qu’il déteste l’eau, il vit sur les plages. Quand la pluie s’abat sur lui, il est incapable de conserver sa forme de château de sable."],"fv":{"27":0,"28":1,"29":2,"30":3,"33":4,"34":5},"gr":4,"cr":60,"hc":15,"bh":70,"eg":["Amorphe"],"gw":"medium","gm":{"zadlc":[0,26],"sv":[0,323],"swisle":[0,134],"sw":[1,134],"usum":[0,226],"usum*":[1,127],"sm":[0,187],"sm*":[1,114]},"f":{"770":{"n":"Trépassable","t":["ghost","ground"],"s":[85,75,110,100,75,35],"h":1.3,"w":250,"a":[[195,0],[8,1]],"av":["zadlc","sv","swisle","sw","usum","sm"],"hi":[[224,5,[27,28,29,30]]],"ls":[{"l":[[71,1],[106,1],[310,1],[328,1],[72,15],[28,20],[523,25],[95,30],[202,35],[334,40],[247,47],[414,54],[659,61],[201,68]],"m":[34,63,89,94,101,109,133,156,157,164,174,180,182,184,188,189,201,202,203,214,220,240,241,247,263,271,285,286,317,328,334,341,356,374,412,414,416,430,444,446,506,523,809,815,851,886]},{"l":[[71,1],[106,1],[310,1],[328,1],[72,15],[28,20],[523,25],[95,30],[202,35],[334,40],[247,47],[414,54],[659,61],[201,68]],"m":[89,94,133,156,157,164,173,182,188,201,202,203,213,214,247,263,271,285,317,328,334,341,362,374,412,414,416,444,446,496,523],"t":[805,809,815]},{"l":[[106,1],[71,1],[310,1],[28,1],[310,5],[28,9],[328,14],[72,18],[523,23],[95,27],[334,32],[202,36],[247,41],[414,47],[659,54],[201,60]],"m":[89,92,94,104,156,157,164,182,188,201,