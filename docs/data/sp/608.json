{"id":608,"gn":"Pokémon Lampe","ft":["Un Pokémon craint pour être de mauvais augure. Il erre dans les villes à la recherche d’âmes de défunts.","Il apparaît au moment du trépas et aspire l’âme à l’instant même où elle quitte le corps.","Il aspire les âmes pour entretenir sa flamme. Il erre dans les hôpitaux dans l’attente d’un trépas.","Comme il apparaît dès qu’une personne est sur le point de trépasser, les gens le craignent et le prennent pour un messager de la mort.","Il se cache en ville en se faisant passer pour un lampadaire. Lorsqu’il repère une personne dont l’heure est proche, il la suit en catimini."],"fv":{"17":0,"18":1,"23":2,"24":1,"25":2,"26":1,"33":3,"34":4},"gr":4,"cr":90,"hc":20,"bh":70,"eg":["Amorphe"],"gw":"medium-slow","gm":{"za":[0,190],"svmask":[0,147],"sv":[1,147],"swcrown":[0,49],"sw":[0,288,2,49],"xy":[2,66],"b2w2":[0,191],"bw":[0,114]},"f":{"608":{"n":"Mélancolux","t":["ghost","fire"],"s":[60,40,60,95,60,55],"h":0.6,"w":13,"a":[[18,0],[49,0],[151,1]],"pa":[[5,[[18,0],[49,0],[23,1]]]],"av":["za","svmask","sv","swcrown","sw","xy","b2w2","bw"],"ls":[{"l":[[52,1],[107,1],[123,1],[310,1],[109,12],[506,16],[261,20],[83,24],[101,28],[174,32],[247,36],[517,40],[286,46],[220,52],[315,58],[262,64]],"m":[53,76,83,94,101,109,114,126,156,164,168,174,180,182,203,214,220,241,244,247,257,261,263,269,271,286,315,347,394,399,412,433,488,506,806,807,808,809,851,915],"e":[114,151,471,499]},{"l":[[310,1],[123,1],[52,1],[107,1],[109,12],[506,16],[261,20],[83,24],[101,28],[174,32],[247,36],[517,40],[286,46],[220,52],[315,58],[262,64]],"m":[53,76,83,94,126,156,164,168,173,182,203,213,214,219,241,247,257,261,263,269,271,286,315,347,371,399,412,433,496,502,506,595],"t":[806,807,809]},{"l":[[52,1],[310,1],[107,1],[123,1],[107,3],[123,5],[83,7],[109,10],[101,13],[261,16],[481,20],[286,24],[506,28],[262,33],[517,38],[174,45],[247,53],[220,61],[315,69]],"m":[53,76,92,94,104,126,138,148,156,164,168,182,207,213,214,216,218,219,237,241,244,247,261,263,269,315,347,371,373,3