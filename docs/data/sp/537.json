{"id":537,"gn":"Pokémon Vibration","ft":["Il fait gicler un liquide paralysant des pustules sur sa tête, et attaque ses ennemis à coups de vibrations.","Son coup de poing est plus fort quand il fait vibrer la pustule dessus. Il peut briser un gros rocher d’un coup.","En faisant vibrer tous les pustules de son corps, il peut provoquer des secousses similaires à celles d’un séisme. Il est proche des Cradopaud.","Ce Pokémon est un excellent masseur grâce aux vibrations de ses pustules. Les personnes âgées l’apprécient particulièrement."],"fv":{"17":0,"18":1,"23":1,"24":0,"25":1,"26":0,"33":2,"34":3},"tt":["En mettant le pouvoir dans ses bosses, il crée des vibrations et augmente la puissance de ses poinçons."],"tv":{"21":0,"22":0},"gr":4,"cr":45,"hc":20,"bh":70,"eg":["Aquatique 1"],"gw":"medium-slow","gm":{"sw":[0,134],"b2w2":[0,230],"bw":[0,43]},"f":{"537":{"n":"Crapustule","t":["water","ground"],"s":[105,95,75,85,75,74],"h":1.5,"w":62,"a":[[33,0],[143,0],[11,1]],"ps":[[5,[105,85,75,85,75,74]]],"av":["sw","b2w2","bw"],"hi":[[128,50,[21,22]],[133,50,[17,18]]],"ls":[{"l":[[409,0],[409,1],[380,1],[497,1],[45,1],[51,1],[48,1],[341,12],[496,16],[61,20],[175,24],[253,30],[392,39],[304,46],[330,54],[240,62],[56,70]],"m":[5,8,25,56,57,63,67,89,91,103,156,157,164,173,182,188,196,203,213,214,240,253,258,263,280,291,304,311,317,330,340,341,371,374,398,409,411,414,416,438,446,447,474,482,496,503,523,599,707,710]},{"l":[[145,1],[45,1],[48,1],[496,1],[48,5],[496,9],[61,12],[341,16],[392,20],[253,23],[330,28],[240,33],[51,36],[175,39],[409,44],[497,49],[56,53],[304,59]],"m":[57,63,70,89,91,92,104,156,157,164,182,188,207,213,216,218,237,240,249,258,263,280,317,371,374,398,411,416,447,474,482,496,497,503,523],"t":[8,67,173,196,214,253,282,283,304,340,380,409,414,446]},{"l":[[145,1],[45,1],[48,1],[496,1],[48,5],[496,9],[61,12],[341,16],[392,20],[253,23],[330,28],[240,33],[51,36],[175,39],[409,44],[497,49],[56,53],[304,59]],"m":[57,63,70,89,91,92,104,156,157,164,182,188,207,213,216,218,