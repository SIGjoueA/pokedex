{"id":610,"gn":"Pokémon Crocs","ft":["Il broie les Baies à grands coups de crocs. Ceux-ci repoussent plusieurs fois, toujours plus forts et aiguisés.","Il laisse la marque de ses crocs dans les arbres pour marquer son territoire. Ses crocs repoussent dès qu’ils tombent.","Il vit dans des terriers qu’il creuse à même le sol, et organise des concours avec ses camarades pour voir qui peut briser la Baie la plus dure.","Il joue avec ses congénères à se donner de grands coups de crocs. Peu importe s’ils se cassent : ils repousseront aussitôt."],"fv":{"17":0,"18":1,"23":0,"24":1,"25":0,"26":1,"33":2,"34":3},"gr":4,"cr":75,"hc":40,"bh":35,"eg":["Monstrueux","Draconique"],"gw":"slow","gm":{"svdisk":[0,140],"sv":[0,155,2,140],"sw":[0,324],"xy":[0,148],"b2w2":[0,183],"bw":[0,116]},"f":{"610":{"n":"Coupenotte","t":["dragon"],"s":[46,87,60,30,40,57],"h":0.6,"w":18,"a":[[79,0],[104,0],[127,1]],"av":["svdisk","sv","sw","xy","b2w2","bw"],"ls":[{"l":[[10,1],[43,1],[44,3],[206,6],[372,9],[269,12],[163,15],[337,18],[184,21],[242,24],[349,27],[784,30],[116,33],[406,36],[14,39],[200,42],[12,45],[416,48]],"m":[14,36,38,46,57,91,129,156,164,179,182,184,200,203,206,214,240,241,242,263,269,280,283,317,332,337,349,374,398,404,406,416,421,434,442,523,525,555,707,784,799,851,885,913],"e":[68,231,283,400,401,660]},{"l":[[10,1],[43,1],[44,3],[206,6],[372,9],[269,12],[163,15],[337,18],[184,21],[242,24],[349,27],[530,30],[673,33],[406,36],[14,39],[200,42],[12,45],[416,48]],"m":[14,91,116,129,156,164,173,179,182,184,200,203,206,213,214,231,240,241,242,263,269,276,317,337,349,371,372,374,398,404,406,416,496,784],"e":[68,106,283,400,660],"t":[434,799]},{"l":[[10,1],[43,4],[372,7],[82,10],[530,13],[184,16],[163,20],[206,24],[337,28],[349,32],[269,36],[406,41],[14,46],[12,50],[200,56],[416,61]],"m":[14,15,46,70,91,92,104,156,164,182,206,207,213,214,216,218,237,240,241,249,263,269,317,332,337,371,374,398,404,416,468,496,510,590],"e":[13,68,106,116,179,203,231,283,400,406],"t":[434]},{"l":[[10,1],[43,4]