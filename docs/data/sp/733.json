{"id":733,"gn":"Pokémon Canon","ft":["Pendant le combat, son bec chauffe et dépasse allègrement les 100 °C. Ses adversaires repartent généralement avec de graves brûlures.","Il fait exploser ses gaz digestifs pour propulser les pépins qu’il a dans le bec, avec une force capable de réduire en miettes de gros rochers.","Ils communiquent entre eux en se frappant mutuellement sur le bec. La force et la cadence des coups en disent long sur leur état d’esprit.","Les couples de Bazoucan sont réputés pour leur harmonie. On en amène souvent aux mariages pour porter bonheur aux jeunes époux."],"fv":{"27":0,"28":1,"29":2,"30":3},"gr":4,"cr":45,"hc":15,"bh":70,"eg":["Aérien"],"gw":"medium","gm":{"svdisk":[0,49],"usum":[0,12],"usum*":[0,12,1,3,2,3,3,3],"sm":[0,12],"sm*":[0,12,1,3,2,3,3,3]},"f":{"733":{"n":"Bazoucan","t":["normal","flying"],"s":[80,120,75,75,75,60],"h":1.1,"w":26,"a":[[51,0],[92,0],[125,1]],"av":["svdisk","usum","sm"],"hi":[[129,5,[27,28,29,30]]],"ls":[{"l":[[690,0],[45,1],[64,1],[249,1],[350,1],[497,1],[48,13],[365,16],[355,21],[31,24],[103,30],[65,34],[331,40],[297,44],[304,50]],"m":[14,19,36,63,129,156,164,168,182,184,203,214,227,241,244,253,257,263,270,280,282,283,297,304,314,315,331,332,350,366,369,402,403,413,416,430,441,479,488,512,542,675,814,851,915],"e":[143,441,586]},{"l":[[690,0],[690,1],[350,1],[64,1],[45,1],[497,1],[249,1],[45,3],[497,7],[249,9],[48,13],[365,16],[355,21],[31,24],[103,30],[65,34],[331,40],[297,44],[304,50]],"m":[14,19,92,104,156,164,168,182,207,211,213,214,216,218,237,241,280,315,332,355,369,430,479,488,496,497,526,590],"t":[143,173,253,257,282,304,366,402,432,441]},{"l":[[690,0],[690,1],[350,1],[64,1],[45,1],[497,1],[249,1],[45,3],[497,7],[249,9],[48,13],[365,16],[355,21],[31,24],[103,30],[65,34],[331,40],[297,44],[304,50]],"m":[14,19,92,104,156,164,168,182,207,211,213,214,216,218,237,241,280,315,332,355,369,430,479,488,496,497,526,590]}],"lm":{"svdisk":0,"usum":1,"sm":2},"go":{"a":222,"d":146,"s":190,"m50":3040,"m51":3076,"t":["nor