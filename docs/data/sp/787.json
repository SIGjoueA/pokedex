{"id":787,"gn":"Pokémon Tutélaire","ft":["Il arrache de grands arbres et fait des moulinets avec. Il a le pouvoir de rendre la végétation luxuriante pour ensuite se nourrir de cette force.","C’est l’indolent gardien d’Ula-Ula. Il se sert de la végétation pour immobiliser ses ennemis, avant de les empaler avec ses cornes.","Bien qu’on le connaisse comme une divinité protectrice, il peut se montrer sans pitié envers ceux qu’il considère comme ses ennemis.","Il est le gardien d’Ula-Ula et le maître des plantes. Il évite les combats inutiles en faisant tinter sa queue pour signaler son arrivée."],"fv":{"27":0,"28":1,"29":2,"30":3},"gr":-1,"cr":3,"hc":15,"bh":70,"eg":["Inconnu"],"gw":"slow","gm":{"usum":[0,385],"usum*":[2,160],"sm":[0,287],"sm*":[2,130]},"f":{"787":{"n":"Tokotoro","t":["grass","fairy"],"s":[70,130,115,85,95,75],"h":1.9,"w":45.5,"a":[[229,0],[140,1]],"av":["usum","sm"],"ls":[{"l":[[580,1],[452,1],[276,1],[212,1],[50,1],[18,1],[110,1],[670,1],[30,8],[202,14],[184,20],[73,26],[532,32],[563,38],[717,43],[428,48],[224,53],[130,58]],"m":[14,46,63,76,92,113,115,157,164,182,206,207,214,216,218,219,237,241,244,259,263,267,269,280,317,339,347,371,374,411,412,416,444,447,496,497,526,555,590,605,684,693],"t":[173,202,235,264,276,334,388,402,428,477,530]},{"l":[[580,1],[452,1],[276,1],[212,1],[50,1],[18,1],[110,1],[670,1],[30,8],[202,14],[184,20],[73,26],[532,32],[563,38],[717,43],[428,48],[224,53],[130,58]],"m":[14,46,63,76,92,113,115,157,164,182,206,207,214,216,218,219,237,241,244,259,263,267,269,280,317,339,347,371,374,411,412,416,444,447,496,497,526,555,590,605,684,693]}],"lm":{"usum":0,"sm":1},"go":{"a":249,"d":215,"s":172,"m50":3865,"m51":3912,"t":["grass","fairy"],"bd":20,"fm":["BULLET_SEED_FAST","ROCK_SMASH_FAST"],"cm":["GRASS_KNOT","DAZZLING_GLEAM","MEGAHORN","SOLAR_BEAM"],"ce":["NATURES_MADNESS"],"th":[100000,100],"cl":"legendary","r":1,"sh":["wild","raid","research","photobomb"]},"en":{"swcrown":[[6,3,70,70,100]],"sm":[[1404,37,60,60,100]],"usum":[[1404,37