{"id":660,"gn":"Pokémon Fouisseur","ft":["Ses grandes oreilles sont si musclées qu’il peut soulever un rocher d’une tonne sans broncher. Ce Pokémon est souvent utilisé sur les chantiers.","Ses oreilles sont de véritables excavateurs, venant à bout des blocs de pierre les plus durs. Après l’effort, il se repose en paressant.","Aussi puissant qu’une pelleteuse, il peut venir à bout de la roche la plus dure. On fait souvent appel à lui pour forer des tunnels.","La fourrure de son ventre est un excellent isolant thermique. Jadis, on fabriquait des vêtements chauds en se servant de sa mue."],"fv":{"23":0,"24":1,"25":0,"26":1,"33":2,"34":3},"gr":4,"cr":127,"hc":15,"bh":70,"eg":["Terrestre"],"gw":"medium","gm":{"za":[0,14],"sw":[0,49],"xy":[0,11]},"f":{"660":{"n":"Excavarenne","t":["normal","ground"],"s":[85,56,77,50,77,78],"h":1,"w":42.4,"a":[[53,0],[167,0],[37,1]],"av":["za","sw","xy"],"ls":[{"l":[[189,1],[43,1],[33,1],[673,1],[98,9],[341,12],[175,15],[24,18],[523,23],[91,28],[340,33],[36,38],[14,43],[89,48],[162,53],[359,58]],"m":[5,7,8,9,14,25,34,57,63,67,89,91,97,156,157,164,168,173,182,188,191,201,203,213,214,231,253,263,276,280,317,328,339,340,341,369,371,374,414,416,441,442,444,447,492,496,523,526,528,667,693,707],"t":[815]},{"l":[[359,1],[563,1],[523,1],[14,1],[33,1],[97,1],[43,1],[98,7],[189,13],[36,15],[341,18],[24,20],[316,26],[175,31],[91,37],[340,42],[162,48],[263,53],[89,57],[359,60]],"m":[14,15,57,63,70,89,91,92,104,156,157,164,168,182,188,201,207,213,214,216,218,237,249,259,263,267,280,317,339,369,371,374,416,444,447,479,496,523,528,590,612]}],"lm":{"sw":0,"xy":1},"go":{"a":112,"d":155,"s":198,"m50":1706,"m51":1726,"t":["normal","ground"],"bd":1,"fm":["MUD_SHOT_FAST","QUICK_ATTACK_FAST"],"cm":["DIG","HYPER_BEAM","EARTHQUAKE","FIRE_PUNCH","SCORCHING_SANDS"],"th":[10000,25],"shm":"FRUSTRATION","pum":"RETURN","r":1,"sh":["wild","raid","evolution","research","photobomb"]},"en":{"xy":[[294,4,30,30,33],[641,24,27,27,10]],"sw":[[93,21,15,26,100],[93,21,60,60,100,