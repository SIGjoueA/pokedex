{"id":647,"gn":"Pokémon Poulain","ft":["Il projette de l’eau depuis ses sabots et se déplace ainsi à grande vitesse. Sa botte secrète est le coup de sabot.","Il parcourt le monde en courant à la surface des mers et des cours d’eau. Il apparaît là où l’eau est très pure.","Lorsqu’il est résolu, de l’énergie sature son corps et le propulse à des vitesses qui dépassent la perception humaine.","Cobaltium, Terrakium et Viridium lui ont appris à se battre. Il poursuit son entraînement en parcourant le monde.","Lorsqu’il livre un combat difficile, la corne sur son front se renforce et se développe, ce qui éveillerait sa véritable puissance."],"fv":{"17":0,"18":1,"23":1,"24":2,"25":1,"26":2,"33":3,"34":4},"tt":["Quand elle est résolue, son corps se remplit de puissance et devient plus rapide. Ses sauts sont alors trop rapides à suivre."],"tv":{"21":0,"22":0},"gr":-1,"cr":3,"hc":80,"bh":35,"eg":["Inconnu"],"gw":"slow","gm":{"zadlc":[0,118],"b2w2":[0,298],"bw":[0,153]},"f":{"647":{"n":"Keldeo","t":["water","fighting"],"s":[91,72,90,129,90,108],"h":1.4,"w":48.5,"a":[[154,0]],"av":["zadlc","b2w2","bw"],"ls":[{"l":[[453,1],[43,1],[24,7],[61,13],[36,19],[270,25],[514,31],[401,37],[533,43],[14,49],[501,55],[526,61],[56,67],[370,73]],"m":[14,15,46,57,63,70,92,104,115,156,164,182,206,207,216,218,219,237,240,244,249,258,263,269,332,347,398,404,411,416,444,496,503,514,526],"t":[173,196,214,270,276,283,340,343,387,401,548]},{"l":[[453,1],[43,1],[24,7],[61,13],[36,19],[270,25],[514,31],[401,37],[533,43],[14,49],[501,55],[526,61],[56,67],[370,73]],"m":[14,15,46,57,63,70,92,104,115,156,164,182,206,207,216,218,219,237,240,244,249,258,263,269,332,347,398,404,411,416,444,496,503,514,526],"t":[548]}],"lm":{"b2w2":0,"bw":1},"go":{"a":260,"d":192,"s":209,"m50":4181,"m51":4231,"t":["water","fighting"],"bd":20,"fm":["POISON_JAB_FAST","LOW_KICK_FAST"],"cm":["AQUA_JET","CLOSE_COMBAT","HYDRO_PUMP","X_SCISSOR","SACRED_SWORD"],"th":[100000,100],"cl":"mythic","r":1,"sh":["wild","research","photobomb"]}