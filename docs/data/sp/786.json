{"id":786,"gn":"Pokémon Tutélaire","ft":["Pokémon candide mais terriblement cruel, c’est le gardien d’Akala. Il puise son énergie dans le parfum entêtant des fleurs.","Avec ses ailes délicates, il répand une poudre mystérieuse et lumineuse quand il vole. Il suffit de le toucher pour retrouver aussitôt le sourire.","C’est le gardien d’Akala. Il saupoudre une pluie d’écailles scintillantes sur les humains et les Pokémon blessés pour les soigner.","Bien qu’on le considère comme une divinité protectrice, cette incarnation parfaite de la nature est aussi innocente que cruelle."],"fv":{"27":0,"28":1,"29":2,"30":3},"gr":-1,"cr":3,"hc":15,"bh":70,"eg":["Inconnu"],"gw":"slow","gm":{"usum":[0,384],"usum*":[1,160],"sm":[0,286],"sm*":[1,130]},"f":{"786":{"n":"Tokopiyon","t":["psychic","fairy"],"s":[70,85,75,130,115,95],"h":1.2,"w":18.6,"a":[[227,0],[140,1]],"av":["usum","sm"],"ls":[{"l":[[678,1],[597,1],[312,1],[212,1],[577,1],[310,1],[110,1],[93,1],[149,8],[60,14],[230,20],[285,26],[473,32],[321,38],[717,43],[326,48],[260,53],[585,58]],"m":[63,85,87,92,94,104,113,115,164,168,182,207,214,216,218,219,237,241,244,247,259,263,267,269,347,374,411,412,416,447,451,473,496,497,590,605],"t":[173,277,285,334,356,472,477,478,502]},{"l":[[678,1],[597,1],[312,1],[212,1],[577,1],[310,1],[110,1],[93,1],[149,8],[60,14],[230,20],[285,26],[473,32],[321,38],[717,43],[326,48],[260,53],[585,58]],"m":[63,85,87,92,94,104,113,115,164,168,182,207,214,216,218,219,237,241,244,247,259,263,267,269,347,374,411,412,416,447,451,473,496,497,590,605]}],"lm":{"usum":0,"sm":1},"go":{"a":259,"d":208,"s":172,"m50":3950,"m51":3998,"t":["psychic","fairy"],"bd":20,"fm":["CONFUSION_FAST","ASTONISH_FAST"],"cm":["PSYSHOCK","MOONBLAST","FOCUS_BLAST","FUTURESIGHT","DRAINING_KISS"],"ce":["NATURES_MADNESS"],"th":[100000,100],"cl":"legendary","r":1,"sh":["wild","raid","research","photobomb"]},"en":{"swcrown":[[6,3,70,70,100]],"sm":[[1403,37,60,60,100]],"usum":[[1403,37,60,60,100]]}}},"hx":["sw"]}