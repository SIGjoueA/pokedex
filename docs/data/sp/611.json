{"id":611,"gn":"Pokémon Hachomenton","ft":["Comme ses crocs brisés ne repoussent pas, il les aiguise après le combat grâce à une pierre ramassée près d’un fleuve.","Leurs crocs peuvent découper des rochers. Leurs querelles de territoire sont extrêmement violentes.","Comme ses crocs brisés ne repoussent pas, il les aiguise avec soin après le combat sur les pierres des rivières.","Une fois cassés, ses crocs ne repoussent pas. Après les combats, il les aiguise avec soin sur les pierres d’un ruisseau.","Son épiderme est dur comme une armure. Il est passé maître dans l’art de charger l’ennemi tout en le transperçant de ses crocs."],"fv":{"17":0,"18":1,"23":1,"24":2,"25":1,"26":2,"33":3,"34":4},"tt":["Une défense brisée ne reviendra pas, de sorte qu'elle aiguise diligemment ses défenses sur des rochers de rivière après la fin d'une bataille."],"tv":{"21":0,"22":0},"gr":4,"cr":60,"hc":40,"bh":35,"eg":["Monstrueux","Draconique"],"gw":"slow","gm":{"svdisk":[0,141],"sv":[0,156],"sw":[0,325],"xy":[0,149],"b2w2":[0,184],"bw":[0,117]},"f":{"611":{"n":"Incisache","t":["dragon"],"s":[66,117,70,40,50,67],"h":1,"w":36,"a":[[79,0],[104,0],[127,1]],"av":["svdisk","sv","sw","xy","b2w2","bw"],"ls":[{"l":[[10,1],[43,1],[44,1],[206,1],[372,9],[269,12],[163,15],[337,18],[184,21],[242,24],[349,27],[784,30],[116,33],[406,36],[14,41],[200,46],[12,51],[416,56]],"m":[14,36,38,46,57,67,91,129,156,164,179,182,184,200,203,206,214,240,241,242,263,269,280,283,317,332,337,349,374,398,404,406,416,421,434,442,523,525,555,707,784,799,851,885,913]},{"l":[[10,1],[43,1],[44,1],[206,1],[372,9],[269,12],[163,15],[337,18],[184,21],[242,24],[349,27],[530,30],[673,33],[406,36],[14,41],[200,46],[12,51],[416,56]],"m":[14,67,91,116,129,156,164,173,179,182,184,200,203,206,213,214,231,240,241,242,263,269,276,317,337,349,371,372,374,398,404,406,416,421,496,707,784],"t":[434,799]},{"l":[[10,1],[43,1],[372,1],[82,1],[43,4],[372,7],[82,10],[530,13],[184,16],[163,20],[206,24],[337,28],[349,32],[269,36],[406,42],[14,48],[