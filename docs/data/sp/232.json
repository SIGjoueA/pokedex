{"id":232,"gn":"Pokémon Armure","ft":["Il attaque en se roulant en boule pour percuter l’ennemi. Il peut abattre une maison d’un seul coup.","Il a des défenses aiguisées et une peau épaisse. Ses charges peuvent détruire une maison.","Plus grandes sont ses défenses, plus haut est son rang dans le troupeau. Elles poussent lentement.","L’attaque favorite de Donphan consiste à se mettre en boule et à charger son ennemi en roulant à pleine vitesse. Une fois qu’il commence à rouler, ce Pokémon a du mal à s’arrêter.","Si Donphan décidait de charger, il pourrait détruire une maison. Grâce à sa force étonnante, ce Pokémon peut aider à déplacer les rochers et les coulées de boue qui bloquent les chemins de montagne."],"fv":{"17":0,"18":0,"23":1,"24":2,"25":3,"26":4},"gr":4,"cr":60,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"medium","gm":{"sv":[0,123],"oras":[0,173],"hgss":[0,201],"e":[0,166],"rs":[0,166],"c":[0,196],"gs":[0,196]},"f":{"232":{"n":"Donphan","t":["ground"],"s":[90,120,120,60,60,50],"h":1.1,"w":120,"a":[[5,0],[8,1]],"pa":[[4,[[5,0]]]],"av":["sv","oras","hgss","e","rs","c","gs"],"hi":[[162,5,[12,13,14,15,16,17,18,21,22]]],"ls":[{"l":[[31,0],[30,1],[45,1],[111,1],[422,1],[424,1],[523,1],[229,6],[205,10],[372,15],[282,19],[21,24],[707,30],[184,37],[89,43],[416,50]],"m":[34,36,38,46,63,89,91,156,157,164,168,174,182,184,189,201,203,204,214,227,240,241,263,270,282,283,304,317,328,334,341,360,398,402,414,416,422,423,424,441,442,444,446,479,484,523,583,667,675,684,707,776,851,861,885]},{"l":[[424,1],[422,1],[30,1],[523,1],[45,1],[111,1],[229,6],[205,10],[372,15],[282,19],[21,24],[31,25],[222,30],[184,37],[89,43],[416,50]],"m":[46,63,70,89,92,104,156,157,164,182,201,207,213,214,216,218,237,241,249,263,290,317,360,397,398,416,444,496,497,523,590],"t":[173,231,276,282,283,304,334,335,340,387,402,414,441,446]},{"l":[[424,1],[422,1],[30,1],[45,1],[111,1],[175,1],[229,6],[282,10],[205,15],[222,19],[21,24],[31,25],[372,31],[184,39],[89,46],[416,54]],"m":[46,63,70,89,92,104,156,157