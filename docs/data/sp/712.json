{"id":712,"gn":"Pokémon Glaçon","ft":["La glace qui couvre son corps bloque les attaques ennemies. Si elle se fissure, il la reconstitue immédiatement en soufflant de l’air glacé.","Il gèle ses ennemis d’une bourrasque à -100 °C. Il vit en troupeau avec ses congénères, dans les neiges éternelles des hautes montagnes.","Grâce à son souffle glacé à - 100 °C, il peut geler l’humidité dans l’air et se façonner une carapace de glace.","Il vit dans les régions les plus froides, agrippé aux Séracrawl. Il gèle ses pattes sur leur dos pour se maintenir en place."],"fv":{"23":0,"24":1,"25":0,"26":1,"33":2,"34":3},"tt":["Vit sur des montagnes couvertes de neige vivace. Il gèle la vapeur d'eau dans l'air pour faire le casque de glace qu'il donne pour la défense."],"tv":{"39":0},"gr":4,"cr":190,"hc":20,"bh":70,"eg":["Monstrueux","Minéral"],"gw":"medium","gm":{"za":[0,174],"sv":[0,363],"la":[0,215],"swcrown":[0,142],"sw":[0,358],"xy":[2,79]},"f":{"712":{"n":"Grelaçon","t":["ice"],"s":[55,69,85,32,35,28],"h":1,"w":99.5,"a":[[20,0],[115,0],[5,1]],"av":["za","sv","la","swcrown","sw","xy"],"ls":[{"l":[[106,1],[229,1],[33,3],[181,6],[174,9],[196,12],[182,15],[419,18],[44,21],[423,24],[334,27],[105,30],[242,33],[36,36],[59,39],[38,42]],"m":[34,36,38,58,59,156,157,164,174,182,196,203,214,240,242,263,317,333,334,360,419,423,444,523,851,861,883,886],"e":[54,243,694]},{"l":[[33,1],[181,5],[420,9],[44,15],[334,21],[242,29],[59,37],[38,47]]},{"l":[[229,1],[106,1],[33,3],[181,6],[174,9],[196,12],[182,15],[419,18],[44,21],[423,24],[334,27],[105,30],[242,33],[36,36],[59,39],[38,42]],"m":[57,58,59,156,157,164,173,182,196,203,213,214,219,240,242,258,263,317,333,334,360,419,423,430,444,496],"e":[54,243,694]},{"l":[[33,1],[44,1],[106,1],[181,5],[196,10],[36,15],[159,20],[174,22],[423,26],[301,30],[229,35],[419,39],[59,43],[105,47],[38,49]],"m":[57,58,59,70,92,104,148,156,157,164,182,207,213,214,216,218,219,237,240,249,258,263,317,360,397,430,444,496,524,590],"e":[54,105,112,243]}],"lm":{"sv":0,"la"