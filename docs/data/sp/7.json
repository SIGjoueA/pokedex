{"id":7,"gn":"Pokémon Minitortue","ft":["Il se réfugie dans sa carapace et réplique en éclaboussant l’ennemi à la première occasion.","Caché sous l’eau, il crache un jet d’eau sur sa proie et se cache à l’intérieur de sa carapace.","La carapace de Carapuce ne sert pas qu’à le protéger. La forme ronde de sa carapace et ses rainures lui permettent d’améliorer son hydrodynamisme. Ce Pokémon nage extrêmement vite.","Caché sous les flots, il crache un jet d’eau sur sa proie et se réfugie à l’intérieur de sa carapace en cas de danger.","Quand il rentre son cou dans sa carapace, il peut projeter de l’eau à haute pression.","S’il se sent menacé, il rétracte ses pattes dans sa carapace pour se protéger et crache de l’eau."],"fv":{"17":0,"18":0,"23":0,"24":1,"25":2,"26":2,"31":3,"32":3,"33":4,"34":5},"gr":1,"cr":45,"hc":20,"bh":70,"eg":["Monstrueux","Aquatique 1"],"gw":"medium-slow","gm":{"za":[0,154],"svdisk":[0,170],"sv":[2,170],"swisle":[0,71],"sw":[1,71],"lgpe":[0,7],"xy":[0,86],"hgss":[0,237],"frlg":[0,7],"c":[0,232],"gs":[0,232],"y":[0,7],"rb":[0,7]},"f":{"7":{"n":"Carapuce","t":["water"],"s":[44,48,65,50,64,43],"h":0.5,"w":9,"a":[[67,0],[44,1]],"ps":[[1,[44,48,65,50,50,43]]],"pa":[[4,[[67,0]]]],"av":["za","svdisk","sv","swisle","sw","lgpe","xy","hgss","frlg","c","gs","y","rb"],"ls":[{"l":[[33,1],[39,1],[55,3],[110,6],[229,9],[44,12],[352,15],[182,18],[240,21],[401,24],[504,27],[334,30],[56,33],[834,36]],"m":[8,34,36,38,56,57,58,59,91,114,156,164,182,196,203,214,240,250,263,264,270,280,311,330,334,341,352,360,374,428,518,710,812,851,861,886],"e":[54,175,243,252,281,323,392,453,791]},{"l":[[33,1],[39,1],[55,3],[110,6],[229,9],[44,12],[352,15],[182,18],[240,21],[401,24],[504,27],[334,30],[56,33],[130,36]],"m":[5,8,25,34,56,57,58,59,91,127,156,164,173,182,196,203,206,213,214,231,240,250,258,263,270,280,291,311,317,330,334,360,362,374,396,406,428,496,503,526],"e":[54,114,175,243,252,281,323,392,453,791],"t":[518,812]},{"l":[[33,1],[39,5],[145,9],[110,14],[55,18],[44,23],[61