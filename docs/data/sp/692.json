{"id":692,"gn":"Pokémon Lance à Eau","ft":["Sa pince projette un jet d’eau sous pression suffisamment puissant pour abattre ses proies en plein vol.","Il est capable de transformer son corps en canon à eau, grâce à la combustion d’un gaz interne. À bout portant, il peut réduire un rocher en miettes.","Sa pince, à la chair délicieuse, tombe parfois. Il se fait alors tout petit et se cache le temps qu’elle repousse.","Il se déplace en propulsant de l’eau par sa pince droite. Il n’est cependant pas très agile et est incapable de nager droit.","S’il perd ses pinces au combat, d’autres repoussent à la place. La chair qu’elles contiennent est un mets très apprécié à Galar.","Il concentre du gaz dans sa pince droite et le fait exploser pour tirer une rafale d’eau sur ses ennemis, comme une balle de pistolet."],"fv":{"23":0,"24":1,"25":0,"26":1,"29":2,"30":3,"33":4,"34":5},"gr":4,"cr":225,"hc":15,"bh":70,"eg":["Aquatique 1","Aquatique 3"],"gw":"slow","gm":{"za":[0,163],"sv":[0,339],"swisle":[0,196],"sw":[1,196],"usum":[0,349],"usum*":[3,96],"xy":[1,32]},"f":{"692":{"n":"Flingouste","t":["water"],"s":[50,53,62,58,63,44],"h":0.5,"w":8.3,"a":[[178,0]],"av":["za","sv","swisle","sw","usum","xy"],"ls":[{"l":[[55,1],[150,1],[175,10],[453,15],[479,20],[468,25],[352,30],[14,35],[396,40],[340,45],[330,50],[152,55]],"m":[14,36,56,57,58,59,127,156,157,164,168,182,189,196,203,214,240,263,270,311,330,341,352,369,396,399,406,430,474,479,482,710,812,851,884,886],"e":[61,401,494]},{"l":[[150,1],[55,1],[11,5],[175,10],[453,15],[479,20],[468,25],[352,30],[14,35],[396,40],[340,45],[330,50],[152,55]],"m":[14,57,58,127,156,157,164,173,182,188,196,203,213,214,231,240,263,270,291,330,340,369,396,406,430,474,482,496,503],"e":[61,401,494],"t":[805,812]},{"l":[[150,1],[55,1],[346,7],[11,9],[145,12],[175,16],[61,20],[14,25],[152,30],[352,34],[479,39],[453,43],[330,48]],"m":[14,57,58,92,104,127,156,157,164,182,188,207,213,214,216,218,237,240,263,369,430,474,479,482,496,503,590],"e":[152,203,270,453,494