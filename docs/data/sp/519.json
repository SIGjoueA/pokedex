{"id":519,"gn":"Pokémon Tipigeon","ft":["Il suit scrupuleusement les consignes de son Dresseur, mais il a du mal à comprendre les ordres trop compliqués.","Ces Pokémon vivent en ville. Ils sont peu farouches et se regroupent souvent dans les parcs ou sur les places.","Un Pokémon très distrait qui oublie les ordres de son Dresseur et reste planté à en attendre de nouveaux.","On en trouve là où vivent les humains. Mieux vaut éviter de les nourrir, sous peine d’en voir arriver des centaines.","Il n’est pas très malin et un peu distrait, mais beaucoup de Dresseurs l’apprécient pour son caractère affectueux et sa bonne volonté."],"fv":{"17":0,"18":1,"23":2,"24":1,"25":2,"26":1,"33":3,"34":4},"gr":4,"cr":255,"hc":15,"bh":70,"eg":["Aérien"],"gw":"medium-slow","gm":{"sw":[0,26],"b2w2":[0,14],"bw":[0,25]},"f":{"519":{"n":"Poichigeon","t":["normal","flying"],"s":[50,55,50,36,30,43],"h":0.3,"w":2.1,"a":[[145,0],[105,0],[79,1]],"av":["sw","b2w2","bw"],"ls":[{"l":[[16,1],[45,1],[43,4],[98,8],[269,12],[314,16],[207,20],[297,24],[197,28],[403,32],[355,36],[366,40],[143,44]],"m":[19,97,116,129,156,164,173,182,203,211,213,214,240,241,253,257,263,269,369,403,496,526],"e":[95,234,273,400,432],"t":[814]},{"l":[[16,1],[45,4],[43,8],[98,11],[314,15],[355,18],[197,22],[269,25],[403,29],[13,32],[297,36],[207,39],[263,43],[366,46],[143,50]],"m":[19,92,104,156,164,182,207,213,216,218,237,240,241,263,269,332,365,369,496,497,526],"e":[95,211,234,253,273,381,516],"t":[143,173,214,253,257,355,366]},{"l":[[16,1],[45,4],[43,8],[98,11],[314,15],[355,18],[197,22],[269,25],[403,29],[13,32],[297,36],[207,39],[263,43],[366,46],[143,50]],"m":[19,92,104,156,164,182,207,213,216,218,237,240,241,263,269,332,365,369,496,497,526],"e":[95,211,234,253,273,381,516]}],"lm":{"sw":0,"b2w2":1,"bw":2},"go":{"a":98,"d":80,"s":137,"m50":958,"m51":970,"t":["normal","flying"],"bd":1,"fm":["QUICK_ATTACK_FAST","AIR_SLASH_FAST"],"cm":["HEAT_WAVE","AERIAL_ACE","AIR_CUTTER"],"th":[10000,25],"shm":"FRUSTRATION","pum":"RETURN",