{"id":391,"gn":"Pokémon Garnement","ft":["Il contrôle habilement l’intensité de la flamme de sa queue pour tenir ses adversaires à distance.","Il attaque en prenant appui sur les murs et les plafonds. Sa queue ardente n’est pas son seul atout."],"fv":{"17":0,"18":0,"23":0,"24":1,"25":0,"26":1},"tt":["Pour intimider les attaquants, il étend le feu sur sa queue pour se faire paraître plus grand.","Il utilise des plafonds et des murs pour lancer des attaques aériennes. Sa queue ardente n'est qu'une arme.","Il contrôle habilement l'intensité du feu sur sa queue pour garder ses ennemis à une distance idéale.","Un plus grand feu sur sa queue et un motif bleu plus brillant sur son visage signifie que son rang dans son paquet est plus élevé.","Plus le bleu sur son visage est profond, plus il deviendra puissant. Il saute sur tous les chemins et atterrit des coups puissants contre ses adversaires avec la flamme sur sa queue."],"tv":{"12":0,"13":1,"14":2,"15":3,"16":3,"21":2,"22":2,"39":4},"gr":1,"cr":45,"hc":20,"bh":70,"eg":["Terrestre","Humanoïde"],"gw":"medium-slow","gm":{"svdisk":[0,195],"sv":[2,195],"la":[0,62],"bdsp":[0,5],"pt":[0,5],"dp":[0,5]},"f":{"391":{"n":"Chimpenfeu","t":["fire","fighting"],"s":[64,78,52,78,52,81],"h":0.9,"w":22,"a":[[66,0],[89,1]],"pa":[[4,[[66,0]]]],"av":["svdisk","sv","la","bdsp","pt","dp"],"ls":[{"l":[[183,0],[10,1],[43,1],[52,1],[269,9],[154,16],[172,19],[364,26],[259,29],[370,36],[83,39],[512,46],[303,49],[394,56]],"m":[7,9,14,36,38,53,67,83,91,97,118,126,129,156,157,164,168,179,182,189,203,214,227,241,244,253,257,261,263,264,269,270,280,282,283,313,315,317,339,369,370,374,394,398,409,410,411,417,421,428,441,446,447,479,488,490,512,519,807,808,851,915,918],"e":[7,9,24,68,116,227,252,257,270,415]},{"l":[[33,1],[52,6],[129,11],[183,16],[172,18],[417,25],[53,34],[38,43]]},{"l":[[183,0],[52,1],[263,1],[53,1],[43,1],[183,1],[417,1],[10,1],[52,7],[269,9],[612,12],[154,16],[172,19],[364,26],[259,29],[370,36],[83,39],[512,46],[303,49],[394,56]],"m":