{"id":600,"gn":"Pokémon Engrenage","ft":["Ils communiquent entre eux en changeant leur sens de rotation. Plus ils sont en colère, plus ils tournent vite.","Il attaque en lançant ses mini-rouages à grande vitesse. Il est en fâcheuse posture s’ils ne reviennent pas.","Le plus grand des rouages projette le plus petit pour attaquer. Ce dernier risque de dépérir s’il ne revient pas.","Quand le combat devient sérieux, la partie extérieure du grand rouage s’aligne parfaitement avec le petit pour accélérer leur rotation.","Ce Pokémon symbolisant la technologie industrielle est souvent utilisé dans le logo des entreprises de Galar."],"fv":{"17":0,"18":1,"23":0,"24":2,"25":0,"26":2,"33":3,"34":4},"tt":["Le corps est composé d'un mini gear et d'un gros équipement. Si le minigear qu'il lance à un ennemi ne revient pas, il mourra."],"tv":{"21":0,"22":0},"gr":-1,"cr":60,"hc":20,"bh":70,"eg":["Minéral"],"gw":"medium-slow","gm":{"sw":[0,114],"b2w2":[0,131],"bw":[0,106]},"f":{"600":{"n":"Clic","t":["steel"],"s":[60,80,95,70,85,50],"h":0.6,"w":51,"a":[[57,0],[58,0],[29,1]],"av":["sw","b2w2","bw"],"ls":[{"l":[[84,1],[11,1],[20,1],[268,1],[451,12],[319,16],[475,20],[435,24],[103,28],[544,32],[199,36],[508,42],[192,48],[63,54]],"m":[63,85,86,103,156,164,173,182,201,203,214,253,263,334,372,408,430,496,502,521,528],"t":[796,798,804]},{"l":[[11,1],[268,1],[84,1],[544,1],[268,6],[84,11],[544,16],[20,21],[451,26],[475,31],[429,36],[103,40],[435,44],[319,48],[508,52],[199,56],[192,60],[63,64]],"m":[63,85,86,92,104,156,164,182,201,207,216,218,237,249,263,397,430,451,496,521,528],"t":[20,173,214,253,277,278,324,334,356,393]},{"l":[[11,1],[268,1],[84,1],[544,1],[268,6],[84,11],[544,16],[20,21],[451,26],[475,31],[429,36],[103,40],[435,44],[319,48],[508,52],[199,56],[192,60],[63,64]],"m":[63,85,86,92,104,156,164,182,201,207,216,218,237,249,263,397,430,451,496,521]}],"lm":{"sw":0,"b2w2":1,"bw":2},"go":{"a":150,"d":174,"s":155,"m50":2088,"m51":2113,"t":["steel"],"bd":5,"fm":["THUNDER_SHOCK_FAST","CH