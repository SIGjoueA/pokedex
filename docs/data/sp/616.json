{"id":616,"gn":"Pokémon Escargot","ft":["Quand on l’attaque, il referme sa visière pour se défendre, et projette un poison visqueux.","Il évolue quand il baigne dans une énergie électrique avec un Carabing. La cause en est inconnue.","S’il est à proximité d’un Carabing et que les deux reçoivent une décharge électrique, ils évoluent en même temps.","Il se recroqueville dans sa carapace en fermant la visière lorsque des ennemis approchent. Carabing peut néanmoins en forcer l’entrée.","Il a l’étrange faculté de réagir à l’énergie électrique. On ne sait trop pourquoi, mais quand il se trouve aux côtés de Carabing, il évolue."],"fv":{"17":0,"18":1,"23":2,"24":1,"25":2,"26":1,"33":3,"34":4},"gr":4,"cr":200,"hc":15,"bh":70,"eg":["Insectoïde"],"gw":"medium","gm":{"swcrown":[0,97],"swisle":[0,64],"sw":[0,275,1,64,2,97],"xy":[2,24],"b2w2":[0,157],"bw":[0,122]},"f":{"616":{"n":"Escargaume","t":["bug"],"s":[50,40,85,40,65,25],"h":0.4,"w":7.7,"a":[[93,0],[75,0],[142,1]],"av":["swcrown","swisle","sw","xy","b2w2","bw"],"ls":[{"l":[[71,1],[182,1],[51,4],[174,8],[72,12],[522,16],[281,20],[151,24],[202,28],[385,32],[34,36],[105,40],[405,44],[515,48]],"m":[34,141,156,164,173,182,188,191,202,203,213,214,226,227,240,263,341,385,390,405,412,474,496],"e":[38,170,364,470],"t":[806]},{"l":[[141,1],[51,4],[117,8],[174,13],[522,16],[72,20],[281,25],[182,28],[151,32],[202,37],[34,40],[405,44],[105,49],[385,50],[515,56]],"m":[92,104,156,164,182,188,207,213,214,216,218,237,240,263,412,474,496,522,590,611],"e":[38,170,189,191,203,226,227,228,364,470]},{"l":[[141,1],[51,4],[117,8],[174,13],[522,16],[72,20],[281,25],[182,28],[151,32],[202,37],[34,40],[405,44],[105,49],[385,52],[515,56]],"m":[92,104,156,164,182,188,207,213,216,218,237,240,263,412,474,496,522],"e":[38,170,189,191,203,226,227,228,364,470],"t":[173,202,214,324,380,450]},{"l":[[141,1],[51,4],[117,8],[174,13],[522,16],[72,20],[281,25],[182,28],[151,32],[202,37],[34,40],[405,44],[105,49],[385,52],[515,56]],"m":[92,104,156,164,182,188,207,