{"id":430,"gn":"Pokémon Big Boss","ft":["Son cri profond peut invoquer une meute de Cornèbre. On l’appelle “le crieur de mauvais augure”.","Son cri profond peut invoquer une meute de Cornèbre. On l’appelle « le crieur de mauvais augure ».","Ce Pokémon nocturne évolue en grandes volées escortées par des Cornèbre.","Un seul des puissants croassements de ce Pokémon nocturne lui permet de rassembler une centaine de Cornèbre, ses sous-fifres.","Si l’un de ses sous-fifres Cornèbre a le malheur de le décevoir ou d’échouer dans sa mission, le Corboss le pourchassera sans le moindre répit.","Il ne pardonne jamais la trahison ou la défaite d’un subordonné. Le bien-être de l’ensemble de la volée en dépend.","Ses sous-fifres font le sale boulot pour lui. Il n’intervient en combat que pour donner le coup de grâce à son ennemi."],"fv":{"17":0,"18":0,"23":1,"24":2,"25":1,"26":2,"27":3,"28":4,"29":5,"30":6},"gr":4,"cr":30,"hc":20,"bh":35,"eg":["Aérien"],"gw":"medium-slow","gm":{"sv":[0,233],"la":[0,141],"bdsp":[0,75],"usum":[0,79],"usum*":[0,79],"sm":[0,278],"sm*":[3,93],"xy":[2,52],"pt":[0,75],"dp":[0,75]},"f":{"430":{"n":"Corboss","t":["dark","flying"],"s":[100,125,52,105,52,71],"h":0.9,"w":27.3,"a":[[15,0],[105,0],[153,1]],"pa":[[4,[[15,0],[105,0]]]],"av":["sv","la","bdsp","usum","sm","xy","pt","dp"],"ls":[{"l":[[17,1],[114,1],[310,1],[389,1],[400,1],[511,1],[207,25],[417,35],[492,45],[399,55],[894,65]],"m":[19,36,38,63,86,94,101,109,114,156,164,168,180,182,184,189,196,203,214,240,241,244,247,253,257,263,269,270,283,297,314,332,347,366,369,399,403,413,416,417,492,506,512,542,555,808,814,851,886,917]},{"l":[[16,1],[555,6],[355,11],[332,18],[400,25],[403,30],[417,34],[399,43],[413,52]]},{"l":[[314,1],[372,1],[310,1],[16,1],[114,1],[212,1],[101,1],[400,1],[64,1],[389,1],[366,1],[269,1],[259,1],[17,1],[207,25],[417,35],[492,45],[400,55],[511,65],[399,75]],"m":[19,63,86,94,104,138,156,164,168,182,203,207,211,213,214,240,241,244,247,259,263,269,332,347,355,365,371,399,416,417,432,555]