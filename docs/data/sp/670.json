{"id":670,"gn":"Pokémon Uniflore","ft":["Il survole les champs de fleurs, et prend soin de celles qui sont sur le point de faner. Au combat, il fait appel à leur force cachée.","Quand les fleurs d’une plate-bande bien soignée éclosent, il apparaît et célèbre la floraison en dansant avec une très grande élégance.","Il cultive des fleurs et les utilise en tant qu’armes. Plus une fleur est belle, plus elle renferme de puissance.","Il fait profiter ses fleurs de ses pouvoirs et met tout son cœur à leur entretien. Gare à ceux qui ravagent ses plates-bandes !"],"fv":{"23":0,"24":1,"25":0,"26":1,"29":2,"30":3},"gr":8,"cr":120,"hc":20,"bh":70,"eg":["Féerique"],"gw":"medium","gm":{"za":[0,39],"sv":[0,146],"usum":[0,101],"usum*":[0,101,2,46,3,45],"xy":[0,69]},"f":{"670":{"n":"Floette","t":["fairy"],"s":[54,45,47,75,98,52],"h":0.2,"w":0.9,"a":[[166,0],[180,1]],"av":["za","sv","usum","xy","zadlc"],"ls":[{"l":[[22,1],[33,1],[584,1],[219,10],[75,15],[273,20],[345,25],[580,27],[572,33],[235,38],[581,43],[585,46],[80,51],[76,58]],"m":[76,94,113,118,129,156,164,182,202,203,204,214,226,240,241,263,270,271,283,285,345,347,402,412,447,500,572,574,577,580,581,605,676,851,885,886,914]},{"l":[[33,1],[22,1],[584,1],[584,6],[381,10],[75,15],[273,20],[345,25],[580,27],[572,33],[312,38],[581,43],[585,46],[80,51],[76,58]],"m":[76,92,94,104,156,164,182,207,213,214,216,218,219,237,240,241,263,267,347,412,447,496,497,590,605],"t":[173,202,215,235,270,277,283,343,388,402,495,502]},{"l":[[33,1],[22,1],[584,6],[381,10],[75,15],[273,20],[345,25],[580,27],[572,33],[312,38],[581,43],[585,46],[80,51],[76,58]],"m":[76,92,94,104,148,156,164,182,207,213,214,216,218,219,237,240,241,263,267,347,412,447,496,497,590,605]}],"lm":{"sv":0,"usum":1,"xy":2},"go":{"a":136,"d":151,"s":144,"m50":1732,"m51":1752,"t":["fairy"],"bd":3,"fm":["VINE_WHIP_FAST","TACKLE_FAST"],"cm":["DAZZLING_GLEAM","PETAL_BLIZZARD","PSYCHIC"],"th":[50000,50],"r":1,"sh":["wild","evolution","research","photobomb"]},"en":{"usum":[[1038,4,54,57,