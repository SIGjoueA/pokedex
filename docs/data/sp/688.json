{"id":688,"gn":"Pokémon Bimane","ft":["Chaque rocher abrite deux Opermine. S’ils se disputent, l’un d’entre eux part à la recherche d’un nouveau logis.","Ils prennent de l’élan avec tout leur corps et soulèvent ainsi leur pierre pour se déplacer. Ils mangent les algues échouées sur le rivage.","Ils vivent par groupes de deux sur un rocher qui leur convient en bord de mer. À marée haute, le duo coopère pour capturer des proies.","Il faut que les deux bras travaillent bien ensemble s’ils souhaitent survivre, sinon leur défense et leur attaque en souffrent grandement."],"fv":{"23":0,"24":1,"25":0,"26":1,"33":2,"34":3},"gr":4,"cr":120,"hc":20,"bh":70,"eg":["Aquatique 3"],"gw":"medium","gm":{"za":[0,34],"sw":[0,234],"xy":[1,21]},"f":{"688":{"n":"Opermine","t":["rock","water"],"s":[42,52,67,39,56,50],"h":0.5,"w":31,"a":[[181,0],[97,0],[124,1]],"av":["za","sw","xy"],"ls":[{"l":[[189,1],[10,1],[110,4],[55,8],[210,12],[154,16],[246,20],[397,24],[163,28],[468,32],[534,36],[504,40],[238,44]],"m":[14,57,58,59,89,91,103,156,157,164,168,173,182,188,196,201,203,206,213,214,219,240,251,253,263,269,270,280,317,334,341,350,371,372,374,398,404,421,444,446,447,482,496,503,523,534,710],"e":[28,400,415]},{"l":[[504,1],[10,1],[28,1],[55,4],[110,7],[154,10],[163,13],[189,18],[128,20],[397,24],[246,28],[468,32],[210,37],[400,41],[534,45],[238,49]],"m":[14,15,57,58,59,70,89,91,92,104,156,157,164,168,182,188,201,206,207,213,214,216,218,219,237,240,249,259,263,267,269,280,317,332,371,373,374,397,398,404,421,444,447,468,479,482,496,503,523,590,611,612],"e":[270,321,346,415]}],"lm":{"sw":0,"xy":1},"go":{"a":96,"d":120,"s":123,"m50":1069,"m51":1082,"t":["rock","water"],"bd":3,"fm":["SCRATCH_FAST","MUD_SLAP_FAST"],"cm":["ANCIENT_POWER","CROSS_CHOP","DIG"],"th":[50000,50],"r":1,"sh":["wild","raid","research","photobomb"]},"en":{"xy":[[776,28,18,20,34,0,[23]],[776,28,13,15,34,0,[24]],[777,28,13,15,34,0,[24]],[779,28,18,20,34,0,[23]],[779,28,13,15,34,0,[24]],[780,28,23,25,34],[781,28,23,25,34]],"sw":