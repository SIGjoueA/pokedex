{"id":747,"gn":"Pokémon Cruel","ft":["Les épines sur sa tête transpercent et empoisonnent l’ennemi. Ses dix tentacules se chargent ensuite du reste.","Il rampe le long des fonds marins et des plages de sable. Les cornes de corail des Corayon sont ses biscuits apéritifs préférés.","Son amour des cornes de Corayon lui vaut l’hostilité des artisans qui les récoltent dans la nature pour en faire des objets.","Une nuit lui suffit à régénérer n’importe quelle partie de son corps, à l’exception de sa tête, et ce, quelle que soit l’étendue des dégâts.","Ses piqûres causent un engourdissement qui se mue en démangeaisons si terribles qu’elles poussent la victime à se gratter jusqu’au sang.","Contrairement aux Vorastérie d’Alola, ceux de Galar ne font pas grand cas des cornes de Corayon."],"fv":{"27":0,"28":1,"29":2,"30":3,"33":4,"34":5},"gr":4,"cr":190,"hc":20,"bh":70,"eg":["Aquatique 1"],"gw":"medium","gm":{"sv":[0,344],"swisle":[0,127],"sw":[0,307,1,127],"usum":[0,136],"usum*":[0,136,1,45],"sm":[0,113],"sm*":[0,113,1,45]},"f":{"747":{"n":"Vorastérie","t":["poison","water"],"s":[50,53,62,43,52,45],"h":0.4,"w":8,"a":[[196,0],[7,0],[144,1]],"av":["sv","swisle","sw","usum","sm"],"hi":[[222,5,[27,28,29,30]]],"ls":[{"l":[[40,1],[64,1],[469,5],[44,10],[474,15],[105,20],[42,25],[390,30],[710,35],[491,40],[398,45],[92,50]],"m":[56,57,58,59,92,114,156,164,182,188,196,203,214,220,240,263,330,334,341,352,390,398,441,474,482,491,679,710,851,861,884,886],"e":[114,254,255,256,611]},{"l":[[40,1],[64,1],[469,5],[44,10],[474,15],[105,20],[42,25],[390,30],[710,35],[599,40],[398,45],[92,50]],"m":[42,56,57,58,59,156,164,173,182,188,196,203,213,214,219,240,258,263,330,334,341,362,371,390,398,441,474,482,496,503,599,710],"e":[114,254,255,256,611]},{"l":[[40,1],[64,5],[44,9],[390,13],[469,17],[92,21],[474,25],[131,29],[105,33],[398,37],[599,41],[42,45],[710,49]],"m":[57,58,59,92,104,156,164,182,188,207,213,214,216,218,219,237,240,258,263,371,398,474,482,496,503,524,590,611],"e":[114,254,255,256],"