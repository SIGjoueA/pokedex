{"id":643,"gn":"Pokémon Blanc Réel","ft":["Un Pokémon mythique. Il projette de sa queue un tourbillon de flammes capable de tout emporter.","Quand sa queue s’embrase, l’énergie thermique dégagée modifie l’atmosphère et bouleverse la météo du monde entier.","Un Pokémon légendaire assez puissant pour embraser le monde entier. Il soutient les défenseurs de la Réalité.","Il vole grâce à la propulsion générée par les flammes de sa queue. Il serait capable de réduire le monde en cendres.","Selon un mythe, lorsque les gens ne font aucun cas de la Réalité et s’abandonnent à la cupidité, Reshiram rase le pays entier avec ses flammes."],"fv":{"17":0,"18":1,"23":2,"24":1,"25":2,"26":1,"33":3,"34":4},"gr":-1,"cr":3,"hc":120,"bh":0,"eg":["Inconnu"],"gw":"slow","gm":{"b2w2":[0,295],"bw":[0,149]},"f":{"643":{"n":"Reshiram","t":["dragon","fire"],"s":[100,120,100,150,120,90],"h":3.2,"w":330,"a":[[163,0]],"av":["b2w2","bw"],"ls":[{"l":[[424,1],[82,1],[286,8],[246,15],[53,22],[225,29],[163,36],[326,43],[558,50],[406,54],[286,64],[242,71],[126,78],[200,85],[304,92],[551,100]],"m":[15,19,53,63,70,76,92,94,104,113,115,126,156,157,164,182,207,216,218,219,237,241,247,249,261,263,315,317,337,371,374,411,416,421,444,468,488,496,497,510,525],"t":[173,200,214,257,304,355,366,406,414,428,434]},{"l":[[424,1],[82,1],[286,8],[246,15],[53,22],[225,29],[163,36],[326,43],[558,50],[406,54],[286,64],[242,71],[126,78],[200,85],[304,92],[551,100]],"m":[15,19,53,63,70,76,92,94,104,113,115,126,156,157,164,182,207,216,218,219,237,241,247,249,261,263,315,317,337,371,374,411,416,421,444,468,488,496,497,510,525],"t":[434]}],"lm":{"b2w2":0,"bw":1},"go":{"a":275,"d":211,"s":205,"m50":4565,"m51":4620,"t":["dragon","fire"],"bd":20,"fm":["DRAGON_BREATH_FAST","FIRE_FANG_FAST"],"cm":["CRUNCH","OVERHEAT","DRACO_METEOR","STONE_EDGE"],"ce":["FUSION_FLARE"],"th":[100000,100],"shm":"FRUSTRATION","pum":"RETURN","cl":"legendary","r":1,"sh":["wild","raid","research","photobomb"]}}}}