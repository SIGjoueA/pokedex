{"id":735,"gn":"Pokémon Filature","ft":["Lorsqu’il est sur les traces d’une proie, ce Pokémon n’est pas du genre à abandonner. Sauf le soir, lorsqu’il tombe de sommeil.","Il est accro au goût des Rattata et Rattatac, mais n’en croise pas beaucoup car ceux-ci sont nocturnes. Heureusement, il sait rester patient.","À l’origine, on ne le trouvait pas à Alola, mais il y a été introduit il y a bien longtemps pour faire face à la prolifération de Rattata.","D’un naturel très patient, il ne peut toutefois s’empêcher de bondir sur son plat favori, Rattata, s’il en voit un."],"fv":{"27":0,"28":1,"29":2,"30":3},"gr":4,"cr":127,"hc":15,"bh":70,"eg":["Terrestre"],"gw":"medium","gm":{"sv":[0,28],"usum":[0,14],"usum*":[0,14,1,5,2,5,3,5],"sm":[0,14],"sm*":[0,14,1,5,2,5,3,5]},"f":{"735":{"n":"Argouste","t":["normal"],"s":[88,110,60,55,60,45],"h":0.7,"w":14.2,"a":[[198,0],[173,0],[91,1]],"av":["sv","usum","sm"],"hi":[[128,5,[27,28,29,30]]],"ls":[{"l":[[28,1],[33,1],[43,1],[371,1],[526,13],[44,19],[189,23],[162,27],[36,31],[184,35],[242,39],[281,43],[37,47],[156,52]],"m":[7,8,9,34,36,38,46,63,89,91,156,162,164,168,174,179,182,184,189,201,203,214,240,241,242,263,264,269,270,282,283,317,341,369,374,402,416,422,423,424,428,442,490,523,528,706,707,851,885,886]},{"l":[[33,1],[43,1],[228,1],[28,1],[43,3],[228,7],[28,10],[316,13],[117,16],[44,19],[189,23],[162,27],[36,31],[184,35],[242,39],[158,43],[281,47],[37,51],[156,55]],"m":[46,89,92,104,156,164,168,182,201,207,213,214,216,218,237,259,263,269,317,369,371,374,496,497,523,526,590],"t":[7,8,9,162,173,231,253,283,335,351,387,428,442,530,707]},{"l":[[33,1],[43,1],[228,1],[28,1],[43,3],[228,7],[28,10],[316,13],[117,16],[44,19],[189,23],[162,27],[36,31],[184,35],[242,39],[158,43],[281,47],[37,51],[156,55]],"m":[46,89,92,104,156,164,168,182,201,207,213,214,216,218,237,259,263,269,317,369,371,374,496,497,523,526,590]}],"lm":{"sv":0,"usum":1,"sm":2},"go":{"a":194,"d":113,"s":204,"m50":2470,"m51":2500,"t":["normal"],"bd":1,"fm":["TAKE_DOWN_FAST",