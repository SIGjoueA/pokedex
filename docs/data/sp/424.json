{"id":424,"gn":"Pokémon Longqueue","ft":["Ses queues jumelles sont si agiles et efficaces qu’il ne se sert que très rarement de ses bras.","Ils vivent en grandes colonies et relient leurs queues pour former un anneau en signe d’amitié.","Il se nourrit de noix qu’il épluche avec ses deux queues habiles. Il utilise de moins en moins ses bras.","Il se dispute constamment les arbres les plus confortables avec Quartermac et remporte la victoire la moitié du temps.","Il utilise toujours ses deux queues pour faire la moindre tâche. Il s’en sert aussi pour enlacer les gens qu’il affectionne tout particulièrement."],"fv":{"17":0,"18":0,"23":1,"24":2,"25":1,"26":2,"29":3,"30":4},"gr":4,"cr":45,"hc":20,"bh":100,"eg":["Terrestre"],"gw":"fast","gm":{"svmask":[0,48],"sv":[1,48],"la":[0,79],"bdsp":[0,64],"usum":[0,369],"usum*":[3,116],"hgss":[0,124],"pt":[0,64],"dp":[0,64]},"f":{"424":{"n":"Capidextre","t":["normal"],"s":[75,100,66,60,66,115],"h":1.2,"w":20.3,"a":[[101,0],[53,0],[92,1]],"pa":[[4,[[101,0],[53,0]]]],"av":["svmask","sv","la","bdsp","usum","hgss","pt","dp"],"ls":[{"l":[[10,1],[28,1],[39,1],[310,1],[226,11],[321,15],[154,18],[129,22],[103,25],[97,29],[458,32],[374,36],[417,39],[387,43]],"m":[7,8,9,36,38,63,67,76,85,86,87,91,97,118,129,156,164,168,180,182,189,203,214,226,240,241,247,263,264,269,270,280,282,283,332,341,352,369,374,402,416,417,421,441,447,479,490,492,512,675,813,851,885,886,918],"e":[21,68,231,251,252,340,343,415,501]},{"l":[[98,1],[417,6],[129,11],[426,18],[458,25],[231,34],[38,43]]},{"l":[[310,1],[530,1],[28,1],[10,1],[39,1],[28,4],[310,8],[226,11],[321,15],[154,18],[129,22],[103,25],[97,29],[458,32],[374,36],[417,39],[387,43]],"m":[15,63,70,76,85,86,87,91,104,138,156,164,168,182,203,207,213,214,231,240,241,247,249,263,264,269,280,332,351,352,369,371,374,416,417,421,447,490,526]},{"l":[[530,1],[10,1],[39,1],[28,1],[310,1],[28,4],[310,8],[226,11],[321,15],[154,18],[129,22],[103,25],[97,29],[458,32],[374,36],[417,39],[387,43]],"m":[63,76,85,86,87,92,104,1