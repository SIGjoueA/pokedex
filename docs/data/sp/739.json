{"id":739,"gn":"Pokémon Boxeur","ft":["Il protège ses points faibles avec ses pinces en guettant le moment propice pour riposter. Il crache de l’écume lorsqu’il tombe K.O.","Ses pinces se décrochent lorsqu’il s’en sert trop pour frapper, mais repoussent heureusement aussitôt. Leur chair est fine et délicieuse.","Ses robustes pinces sont aussi efficaces pour l’attaque que pour la défense. Les combats de Crabagarre ressemblent à des matchs de boxe.","Il grimpe parfois sur un Noadkoko qu’il a pris pour un cocotier. Il se fait alors éjecter puis piétiner par le Noadkoko courroucé."],"fv":{"27":0,"28":1,"29":2,"30":3},"gr":4,"cr":225,"hc":20,"bh":70,"eg":["Aquatique 3"],"gw":"medium","gm":{"zadlc":[0,87],"svdisk":[0,72],"sv":[0,118,2,72],"usum":[0,71],"usum*":[0,71,1,21,2,30,3,24],"sm":[0,59],"sm*":[0,59,1,21,2,30,3,17]},"f":{"739":{"n":"Crabagarre","t":["fighting"],"s":[47,82,57,42,47,63],"h":0.6,"w":7,"a":[[52,0],[89,0],[83,1]],"av":["zadlc","svdisk","sv","usum","sm"],"hi":[[130,5,[27,28,29,30]]],"ls":[{"l":[[249,5],[43,9],[61,13],[182,17],[280,22],[21,25],[371,29],[179,33],[152,37],[334,42],[223,45],[370,49]],"m":[8,9,34,36,89,91,129,133,156,157,164,168,179,182,189,203,214,240,241,263,264,270,280,282,283,317,334,339,341,370,374,409,411,428,441,442,523,707,710,811,851,886,918],"e":[264,276,283,469]},{"l":[[145,1],[249,5],[43,9],[228,13],[61,17],[612,22],[146,25],[371,29],[179,33],[152,37],[334,42],[223,45],[370,49]],"m":[89,92,104,156,157,164,168,182,207,213,214,216,218,237,240,241,263,280,317,339,371,374,411,444,496,503,523,524,526,590,693],"e":[133,276,283,469],"t":[8,9,173,264,276,283,334,409,428,442,530]},{"l":[[145,1],[249,5],[43,9],[228,13],[61,17],[612,22],[146,25],[371,29],[179,33],[152,37],[334,42],[223,45],[370,49]],"m":[89,92,104,156,157,164,168,182,207,213,214,216,218,237,240,241,263,280,317,339,371,374,411,444,496,503,523,524,526,590,693],"e":[133,276,283,469]}],"lm":{"svdisk":0,"sv":0,"usum":1,"sm":2},"go":{"a":150,"d":104,"s":132,"m50":1540,"m51":1559,"t