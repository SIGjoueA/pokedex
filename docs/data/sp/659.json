{"id":659,"gn":"Pokémon Fouisseur","ft":["Ses larges oreilles lui permettent de creuser des terriers. Il est capable de forer sans s’arrêter pendant toute une nuit.","Il est doté d’oreilles ressemblant à des pelles. À force de creuser des galeries, leur puissance est telle qu’elles peuvent trancher de grosses racines.","Il est très doué pour creuser avec ses oreilles. Il peut forer un terrier atteignant dix mètres de profondeur en une nuit.","Il est sensible au danger. Lorsqu’il entend le battement d’ailes de Corvaillus, il creuse prestement un terrier et s’y cache."],"fv":{"23":0,"24":1,"25":0,"26":1,"33":2,"34":3},"gr":4,"cr":255,"hc":15,"bh":70,"eg":["Terrestre"],"gw":"medium","gm":{"za":[0,13],"sw":[0,48],"xy":[0,10]},"f":{"659":{"n":"Sapereau","t":["normal"],"s":[38,36,38,32,36,57],"h":0.4,"w":5,"a":[[53,0],[167,0],[37,1]],"av":["za","sw","xy"],"ls":[{"l":[[189,1],[43,1],[33,3],[673,6],[98,9],[341,12],[175,15],[24,18],[523,21],[91,24],[340,27],[36,30],[14,33],[89,36],[162,39]],"m":[14,57,89,91,97,156,157,164,168,173,182,188,191,201,203,213,214,231,263,280,317,339,340,341,369,371,374,442,444,447,496,523,526,528],"e":[111,205]},{"l":[[33,1],[97,1],[43,1],[98,7],[3,10],[189,13],[36,15],[341,18],[24,20],[316,25],[175,29],[91,33],[340,38],[162,42],[263,47],[89,49]],"m":[15,57,70,89,91,92,104,156,157,164,168,182,188,201,207,213,214,216,218,237,249,259,263,267,280,317,339,369,371,374,444,447,479,496,523,528,590,612],"e":[111,191,205]}],"lm":{"sw":0,"xy":1},"go":{"a":68,"d":72,"s":116,"m50":625,"m51":633,"t":["normal"],"bd":1,"fm":["MUD_SLAP_FAST","QUICK_ATTACK_FAST"],"cm":["DIG","BULLDOZE","EARTHQUAKE"],"th":[10000,25],"shm":"FRUSTRATION","pum":"RETURN","r":1,"sh":["wild","raid","research","photobomb"]},"en":{"xy":[[74,4,2,3,20],[122,4,3,4,20],[641,4,5,6,20],[701,4,8,10,30],[701,25,10,10,10]],"sw":[[93,4,7,9,100,0,[33]],[93,4,60,60,100,[1]],[93,4,7,10,100,0,[34]],[93,11,7,10,100],[93,11,60,60,100,[1]],[95,4,8,12,30],[95,4,60,60,30,[1]],[351,11,28,30,50],[351,11,60,60,