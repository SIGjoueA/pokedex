{"id":693,"gn":"Pokémon Blaster","ft":["Son énorme pince projette de véritables obus d’eau capables de transpercer la coque d’un pétrolier.","La force de propulsion générée par l’expulsion de l’eau via la tuyère située à l’arrière de sa pince peut lui conférer une vitesse de 60 nœuds.","Il aspire de l’eau et la projette sous pression pour attaquer. Le jet est si puissant qu’il perce même d’épaisses plaques d’acier.","La chair de sa pince droite est très ferme. Les pinces tombées sont vendues à l’étranger comme ingrédients de cuisine.","Il projette des obus d’eau sur ses ennemis après les avoir localisés grâce aux antennes situées sur son énorme pince.","Sa pince droite est un canon pouvant projeter des obus d’eau assez puissants pour couler un navire-citerne."],"fv":{"23":0,"24":1,"25":0,"26":1,"29":2,"30":3,"33":4,"34":5},"gr":4,"cr":55,"hc":15,"bh":70,"eg":["Aquatique 1","Aquatique 3"],"gw":"slow","gm":{"za":[0,164],"sv":[0,340],"swisle":[0,197],"sw":[1,197],"usum":[0,350],"usum*":[3,97],"xy":[1,33]},"f":{"693":{"n":"Gamblast","t":["water"],"s":[71,73,88,120,89,59],"h":1.3,"w":35.3,"a":[[178,0]],"av":["za","sv","swisle","sw","usum","xy"],"ls":[{"l":[[55,1],[150,1],[175,1],[399,1],[406,1],[505,1],[453,15],[479,20],[468,25],[352,30],[14,35],[396,42],[340,49],[330,56],[152,63]],"m":[14,34,36,56,57,58,59,63,127,156,157,164,168,182,184,188,189,196,203,214,240,247,263,270,311,330,341,352,369,396,399,406,411,416,430,474,479,482,710,812,851,884,886]},{"l":[[399,1],[406,1],[505,1],[150,1],[55,1],[11,1],[175,1],[453,15],[479,20],[468,25],[352,30],[14,35],[396,42],[340,49],[330,56],[152,63]],"m":[14,57,58,63,127,156,157,164,173,182,188,196,203,213,214,231,240,247,263,270,291,330,340,369,396,399,406,411,416,430,474,482,496,503,710],"t":[805,812]},{"l":[[396,0],[396,1],[399,1],[406,1],[505,1],[150,1],[55,1],[346,1],[11,1],[346,7],[11,9],[145,12],[175,16],[61,20],[14,25],[152,30],[352,34],[479,42],[453,49],[330,57]],"m":[14,57,58,63,92,104,127,156,157,164,182,188,207,213,214,21