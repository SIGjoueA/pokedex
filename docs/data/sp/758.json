{"id":758,"gn":"Pokémon Toxilézard","ft":["Curieusement, cette espèce ne compte que des femelles. Ces dernières aiment s’entourer de nombreux admirateurs Tritox mâles.","Son gaz toxique est riche en phéromones. Il est possible d’isoler ces dernières pour concocter un puissant parfum aphrodisiaque.","Ce Pokémon habite au fin fond des cavernes. Il se fait servir par des Tritox envoûtés par ses phéromones.","Malamandre punit sans merci les Tritox qui rentrent bredouilles de la chasse, généralement d’une gifle de sa paume enflammée.","Il n’existe que des spécimens femelles. Elles envoûtent les Tritox mâles grâce à leurs nuages de phéromones.","Les conflits entre Malamandre seraient réglés par un simple calcul : le spécimen dont la suite comporte le plus de Tritox l’emporte."],"fv":{"27":0,"28":1,"29":2,"30":3,"33":4,"34":5},"gr":8,"cr":45,"hc":20,"bh":70,"eg":["Monstrueux","Draconique"],"gw":"medium","gm":{"svmask":[0,169],"sv":[0,121],"swisle":[0,160],"sw":[0,245],"usum":[0,196],"usum*":[1,97],"sm":[0,162],"sm*":[1,89]},"f":{"758":{"n":"Malamandre","t":["poison","fire"],"s":[68,64,60,111,60,117],"h":1.2,"w":22.2,"a":[[212,0],[12,1]],"av":["svmask","sv","swisle","sw","usum","sm"],"hi":[[205,5,[27,28,29,30]]],"ls":[{"l":[[680,0],[283,1],[282,1],[259,1],[207,1],[139,1],[227,1],[52,1],[50,1],[10,1],[123,1],[1,1],[305,15],[230,20],[417,25],[510,30],[474,37],[406,44],[53,51],[92,58]],"m":[34,36,53,63,86,92,97,126,129,141,156,164,168,182,184,188,189,203,214,227,241,257,261,263,269,270,282,283,304,313,315,337,342,349,374,390,394,398,406,416,417,421,424,441,474,482,491,492,512,784,799,806,807,851,885,913,915]},{"l":[[680,0],[680,1],[282,1],[227,1],[259,1],[207,1],[50,1],[10,1],[283,1],[1,1],[139,1],[123,1],[52,1],[305,15],[230,20],[417,25],[510,30],[474,37],[406,44],[599,51],[53,58],[92,65]],"m":[53,86,126,129,141,156,164,168,173,182,188,203,213,214,227,231,251,257,261,263,269,270,313,315,337,349,371,374,394,398,406,417,421,440,441,474,482,492,496,512,599,784],"t":[799,806,810]