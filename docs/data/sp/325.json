{"id":325,"gn":"Pokémon Rebond","ft":["Il utilise sa queue comme un ressort et bondit partout. Chaque nouveau choc fait battre son cœur.","Il rebondit sur sa queue pour faire battre son cœur. La perle sur sa tête vient d’un Coquiperl.","Spoink rebondit sur sa queue. Le choc du rebond fait battre son cœur. Du coup, ce Pokémon ne peut pas s’arrêter de rebondir, sinon, son cœur s’arrête.","Spoink garde une perle sur sa tête. Elle lui sert à amplifier ses pouvoirs télékinétiques. Il est constamment en quête d’une perle plus grosse."],"fv":{"17":0,"18":0,"23":0,"24":1,"25":2,"26":3},"gr":4,"cr":255,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"fast","gm":{"zadlc":[0,84],"svmask":[0,125],"sv":[0,111,1,125],"oras":[0,115],"xy":[1,7],"b2w2":[0,206],"e":[0,110],"rs":[0,110]},"f":{"325":{"n":"Spoink","t":["psychic"],"s":[60,25,35,70,80,60],"h":0.7,"w":30.6,"a":[[47,0],[20,0],[82,1]],"pa":[[4,[[47,0],[20,0]]]],"av":["zadlc","svmask","sv","oras","xy","b2w2","e","rs"],"hi":[[133,50,[21,22]],[171,5,[12,13,14,15,16,17,18]]],"ls":[{"l":[[150,1],[93,7],[45,10],[60,14],[244,18],[109,22],[156,29],[408,29],[173,33],[473,38],[371,40],[94,44],[340,50]],"m":[34,36,60,86,94,101,109,113,115,129,133,156,164,168,182,196,203,214,227,240,241,244,247,248,253,263,269,270,271,283,285,286,347,408,428,430,433,447,451,473,500,555,605,678,679,797,851,883,885,886],"e":[18,133,243,248,271,326,428,493]},{"l":[[150,1],[149,7],[316,10],[60,14],[244,15],[109,18],[277,21],[428,26],[408,29],[156,29],[173,33],[473,38],[371,40],[94,44],[340,50]],"m":[86,92,94,104,113,115,138,148,156,164,168,182,207,213,214,216,218,237,240,241,244,247,259,263,269,290,347,371,433,447,451,473,496,590],"e":[18,133,203,243,248,271,285,326,381,428,493],"t":[173,196,215,231,271,272,277,278,285,289,324,340,343,351,428]},{"l":[[150,1],[149,7],[316,10],[60,14],[244,15],[109,18],[277,21],[428,26],[156,29],[173,29],[408,33],[473,38],[371,40],[94,44],[340,50]],"m":[86,92,94,104,113,115,138,148,156,164,168,182,207,213,214,216,218,237,240,241,244,