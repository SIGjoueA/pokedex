{"id":314,"gn":"Pokémon Luciole","ft":["Il utilise son doux parfum pour aider Muciole à décrire des arabesques dans le ciel nocturne.","Il utilise son doux parfum pour aider Muciole à décrire plus de 200 arabesques dans le ciel nocturne.","Lumivole peut attirer un essaim de Muciole grâce à son doux parfum. Une fois les Muciole rassemblés, ce Pokémon dirige cette nuée lumineuse et lui fait dessiner des figures géométriques dans la nuit étoilée.","Lumivole dirige un vol de Muciole lumineux pour dessiner des figures dans la nuit étoilée. On raconte que ce Pokémon gagne le respect de ses pairs en composant des figures complexes dans le ciel."],"fv":{"17":0,"18":0,"23":1,"24":0,"25":2,"26":3},"gr":8,"cr":150,"hc":15,"bh":70,"eg":["Insectoïde","Humanoïde"],"gw":"fast-then-very-slow","gm":{"svmask":[0,10],"sv":[1,10],"oras":[0,90],"xy":[0,134],"e":[0,87],"rs":[0,87]},"f":{"314":{"n":"Lumivole","t":["bug"],"s":[65,47,75,73,85,85],"h":0.6,"w":17.7,"a":[[12,0],[110,0],[158,1]],"ps":[[6,[65,47,55,73,75,85]]],"pa":[[3,[[12,0]]],[4,[[12,0],[110,0]]]],"av":["svmask","sv","oras","xy","e","rs"],"hi":[[190,5,[25,26,27,28,29,30]]],"ls":[{"l":[[33,1],[589,1],[230,5],[204,9],[98,12],[522,15],[236,19],[273,22],[227,26],[260,29],[428,33],[270,36],[405,40],[583,43],[611,47]],"m":[8,9,36,38,76,85,86,87,109,113,118,129,156,164,168,182,189,202,203,204,214,226,227,240,241,244,247,263,264,270,271,280,283,313,314,332,352,366,369,374,403,405,428,450,451,512,522,574,577,583,605,806,851,884,885],"e":[74,213,355]},{"l":[[589,1],[33,1],[230,5],[204,9],[98,12],[522,15],[236,19],[273,22],[227,26],[260,29],[428,33],[270,36],[405,40],[583,43],[343,47]],"m":[76,85,86,87,92,104,113,148,156,164,168,182,207,213,214,216,218,237,240,241,244,247,263,280,290,332,355,369,374,451,496,512,522,590,605,612],"e":[74,109,226,227,313,318,405,445],"t":[8,9,173,202,264,270,343,351,352,366,428,450]},{"l":[[33,1],[589,1],[230,5],[204,9],[236,13],[98,17],[273,21],[227,25],[260,29],[270,33],[428,37],[405,41],[343,45]],"m":[7