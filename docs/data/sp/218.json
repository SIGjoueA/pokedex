{"id":218,"gn":"Pokémon Lave","ft":["Son corps est fait de magma. S’il cesse de bouger, il refroidit et durcit.","Commun dans les régions volcaniques, il se déplace sans cesse pour trouver des endroits chauds.","Du magma en fusion coule dans les veines de Limagma. Si ce Pokémon est refroidi, le magma se solidifie. Son corps devient alors cassant et des morceaux s’en détachent, diminuant ainsi sa taille.","Les veines de Limagma ne contiennent pas de sang. Au lieu de ça, du magma en fusion circule dans le corps de ce Pokémon, apportant les nutriments et l’oxygène nécessaires à ses organes."],"fv":{"17":0,"18":0,"23":1,"24":0,"25":2,"26":3},"gr":4,"cr":190,"hc":20,"bh":70,"eg":["Amorphe"],"gw":"medium","gm":{"svmask":[0,144],"sv":[1,144],"oras":[0,108],"xy":[2,12],"hgss":[0,216],"e":[0,103],"rs":[0,103],"c":[0,211],"gs":[0,211]},"f":{"218":{"n":"Limagma","t":["fire"],"s":[40,40,40,70,40,20],"h":0.7,"w":35,"a":[[40,0],[49,0],[133,1]],"pa":[[4,[[40,0],[49,0]]]],"av":["svmask","sv","oras","xy","hgss","e","rs","c","gs"],"ls":[{"l":[[123,1],[281,1],[52,6],[88,8],[106,13],[499,20],[246,22],[510,27],[157,29],[436,34],[133,36],[34,41],[105,43],[53,48],[414,50]],"m":[34,36,53,83,89,113,115,126,133,156,157,164,174,182,189,201,203,214,220,241,257,261,263,315,317,334,341,350,408,414,444,446,479,488,523,535,667,851,915],"e":[108,151,174,205,254,262,385,517]},{"l":[[281,1],[123,1],[52,6],[88,8],[106,13],[510,15],[499,20],[246,22],[481,27],[157,29],[436,34],[133,36],[34,41],[105,43],[53,48],[414,50]],"m":[53,92,104,113,115,126,156,157,164,182,207,213,214,216,218,237,241,249,261,263,267,290,315,317,488,496,510,590,611],"e":[108,151,174,205,254,255,256,257,262,385,414,517],"t":[173,220,257,334,414,495]},{"l":[[281,1],[123,1],[52,5],[88,10],[106,14],[105,19],[481,23],[246,28],[133,32],[436,37],[157,41],[34,46],[53,50],[414,55]],"m":[53,92,104,113,115,126,156,157,164,182,207,213,214,216,218,237,241,249,261,263,267,315,317,488,496,510,590,611],"e":[108,151,174,205,254,255,256,257,262,385,