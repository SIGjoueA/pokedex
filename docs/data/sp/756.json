{"id":756,"gn":"Pokémon Luminescent","ft":["Il est risqué de s’aventurer la nuit dans un bois peuplé de Lampignon. Attirés par leur lumière envoûtante, certains n’en sont jamais revenus.","Il projette des spores clignotantes qui hypnotisent et endorment ses proies, avant de venir absorber leur énergie vitale.","Il endort ses victimes puis aspire leur énergie vitale avec ses doigts. Il aide ses congénères affaiblis en partageant cette énergie avec eux.","Quand un conflit territorial éclate entre Parasect et lui, un brouillard de spores envahit toute la zone.","Il attire ses proies et les endort grâce au clignotement de ses spores. Il aspire ensuite leur énergie vitale du bout de ses doigts.","Il ne faut pas s’approcher des lumières qui luisent la nuit au fond des bois, sous peine de se faire endormir par un Lampignon."],"fv":{"27":0,"28":1,"29":2,"30":3,"33":4,"34":5},"gr":4,"cr":75,"hc":20,"bh":70,"eg":["Végétal"],"gw":"medium","gm":{"sw":[0,341],"usum":[0,179],"usum*":[1,80,2,71],"sm":[0,146],"sm*":[1,73,2,65]},"f":{"756":{"n":"Lampignon","t":["grass","fairy"],"s":[60,45,80,90,100,30],"h":1,"w":11.5,"a":[[35,0],[27,0],[44,1]],"av":["sw","usum","sm"],"hi":[[86,50,[27,28,29,30]],[87,5,[27,28,29,30]]],"ls":[{"l":[[71,1],[310,1],[109,1],[275,1],[72,12],[79,16],[236,20],[668,27],[202,32],[605,38],[147,44],[585,50],[138,56]],"m":[63,76,86,113,133,156,164,173,182,188,202,203,213,214,219,240,241,263,311,402,409,412,416,447,472,478,496,577,605,676]},{"l":[[71,1],[310,1],[275,1],[148,1],[310,4],[148,8],[236,11],[72,15],[79,18],[275,22],[109,26],[202,31],[668,35],[147,40],[585,44],[138,49],[671,53]],"m":[76,86,92,104,113,138,156,164,182,188,207,213,214,216,218,219,237,241,267,412,416,447,451,496,590,605],"t":[173,202,235,277,278,324,388,402,472,478,495]},{"l":[[71,1],[310,1],[275,1],[148,1],[310,4],[148,8],[236,11],[72,15],[79,18],[275,22],[109,26],[202,31],[668,35],[147,40],[585,44],[138,49],[671,53]],"m":[76,86,92,104,113,138,156,164,182,188,207,213,214,216,218,219,237,267,