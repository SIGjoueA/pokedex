{"id":614,"gn":"Pokémon Congelé","ft":["Il fait lui-même geler son haleine. Il est bon nageur et sillonne les mers du nord à la recherche de ses proies.","Il gèle son haleine et en fait des crocs et des griffes de glace pour combattre. Il vit dans les terres gelées du nord.","Il aime les mers glaciales du nord. Il y trace son chemin en créant des îlots de glace pour éviter de nager.","Les crocs qu’il façonne en gelant son souffle sont plus durs que l’acier. Il sillonne les eaux des mers glaciales à la recherche de nourriture.","Il sillonne les mers glaciales avec aisance. Quand il est fatigué, il gèle l’eau de mer d’un souffle et se repose sur l’iceberg improvisé."],"fv":{"17":0,"18":1,"23":2,"24":1,"25":2,"26":1,"33":3,"34":4},"gr":4,"cr":60,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"medium","gm":{"svdisk":[0,154],"sv":[0,356,2,154],"swcrown":[0,122],"sw":[0,280,2,122],"xy":[2,82],"b2w2":[0,196],"bw":[0,120]},"f":{"614":{"n":"Polagriffe","t":["ice"],"s":[95,130,80,70,80,50],"h":2.6,"w":260,"a":[[81,0],[202,0],[33,1]],"ps":[[6,[95,110,80,70,80,50]]],"pa":[[6,[[81,0],[33,1]]]],"av":["svdisk","sv","swcrown","sw","xy","b2w2","bw"],"hi":[[130,50,[17,18,21,22]]],"ls":[{"l":[[556,0],[203,1],[45,1],[154,1],[181,1],[204,1],[453,1],[196,9],[589,12],[362,15],[524,18],[163,21],[175,24],[207,27],[883,30],[37,33],[156,36],[59,41],[329,46],[276,51]],"m":[8,14,34,36,38,46,57,58,59,63,67,89,91,156,157,164,168,174,179,182,184,189,196,203,204,214,227,232,240,242,263,264,269,280,283,317,332,333,339,341,352,370,374,404,411,416,419,421,423,444,447,484,523,555,583,675,710,776,851,883,885,886,912]},{"l":[[556,0],[556,1],[453,1],[204,1],[181,1],[45,1],[203,1],[154,1],[196,9],[589,12],[362,15],[524,18],[163,21],[175,24],[207,27],[258,30],[37,33],[156,36],[59,41],[329,46],[276,51]],"m":[5,8,14,25,57,58,59,63,67,91,156,157,164,173,182,184,196,203,204,213,214,227,240,258,263,269,276,280,291,317,333,339,362,372,374,411,416,419,421,423,444,447,484,496,523,583,675,710,776]},{"l":[[329,1],[37,1],[27