{"id":114,"gn":"Pokémon Vigne","ft":["Il se cache derrière des lianes bleues recouvertes d’un fin duvet. Il est chatouilleux.","Ses lianes s’allongent au fil du temps. Elles recouvrent tout son corps, dont on ignore la véritable forme.","Il paralyse tout ce qui bouge avec ses lianes. Elles vous chatouillent si vous êtes capturé.","Les lianes de Saquedeneu se brisent facilement lorsqu’on les attrape. Cela ne lui fait pas mal et lui permet simplement de s’échapper rapidement. Les lianes cassées repoussent le lendemain.","Son corps est masqué par une masse épaisse de lianes bleues qui poussent en permanence.","On ne sait toujours pas ce qui se cache sous ses lianes. Même si on les coupe, elles repoussent à l’infini.","Ses lianes ont une odeur particulière. Elles servent d’herbes aromatiques dans une certaine zone de Galar."],"fv":{"17":0,"18":0,"23":1,"24":2,"25":3,"26":3,"31":4,"32":4,"33":5,"34":6},"gr":4,"cr":45,"hc":20,"bh":70,"eg":["Végétal"],"gw":"medium","gm":{"la":[0,95],"swisle":[0,80],"sw":[1,80],"lgpe":[0,114],"b2w2":[0,217],"hgss":[0,182],"pt":[0,181],"frlg":[0,114],"c":[0,179],"gs":[0,179],"y":[0,114],"rb":[0,114]},"f":{"114":{"n":"Saquedeneu","t":["grass"],"s":[65,55,115,100,40,60],"h":1,"w":35,"a":[[34,0],[102,0],[144,1]],"ps":[[1,[65,55,115,100,100,60]]],"pa":[[3,[[34,0]]],[4,[[34,0],[102,0]]]],"av":["la","swisle","sw","lgpe","b2w2","hgss","pt","frlg","c","gs","y","rb"],"hi":[[216,100,[20]]],"ls":[{"l":[[71,1],[78,6],[77,11],[491,15],[458,18],[412,25],[246,34],[79,43]]},{"l":[[71,1],[20,1],[78,4],[74,8],[72,12],[22,16],[77,20],[246,24],[282,28],[202,32],[79,36],[21,40],[321,44],[438,48],[275,52],[580,56]],"m":[14,34,63,76,115,133,156,164,168,173,182,188,202,203,213,214,241,263,331,384,402,412,416,437,438,447,496,580],"e":[73,93,175,267,283,476],"t":[803]},{"l":[[71,1],[132,1],[79,5],[93,10],[22,15],[77,17],[20,22],[74,27],[78,29],[72,34],[73,39],[21,44],[133,49],[438,54]],"m":[29,63,72,76,92,115,156,164,182,188,263]},{"l":[[275,1],[132,1],[79,4],[22,7],