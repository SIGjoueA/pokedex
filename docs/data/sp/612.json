{"id":612,"gn":"Pokémon Hachomenton","ft":["Il est doux, mais ne pardonne pas à ceux qui viennent saccager son territoire. Ses crocs peuvent découper de l’acier.","Ses crocs sont tellement puissants qu’ils peuvent découper l’acier sans s’émousser. Son armure est très solide.","Ses longs crocs robustes sont sa plus grande fierté. Il lèche le sol pour en absorber les minéraux et ainsi renforcer sa dentition.","D’un naturel doux, il est cependant redoutable lorsqu’il se fâche. Il est très fier de ses crocs qui peuvent même découper des poutres d’acier."],"fv":{"17":0,"18":1,"23":0,"24":1,"25":0,"26":1,"33":2,"34":3},"gr":4,"cr":45,"hc":40,"bh":35,"eg":["Monstrueux","Draconique"],"gw":"slow","gm":{"svdisk":[0,142],"sv":[0,157,2,142],"sw":[0,326],"xy":[0,150],"b2w2":[0,185],"bw":[0,118]},"f":{"612":{"n":"Tranchodon","t":["dragon"],"s":[76,147,90,60,70,97],"h":1.8,"w":105.5,"a":[[79,0],[104,0],[127,1]],"av":["svdisk","sv","sw","xy","b2w2","bw"],"ls":[{"l":[[10,1],[43,1],[44,1],[206,1],[372,9],[269,12],[163,15],[337,18],[184,21],[242,24],[349,27],[784,30],[116,33],[406,36],[14,41],[200,46],[12,53],[416,60]],"m":[14,34,36,38,46,57,63,67,89,91,129,156,157,164,179,182,184,200,203,206,214,240,241,242,263,269,280,283,317,332,337,349,370,374,398,404,406,411,416,421,434,442,447,490,523,525,555,707,784,799,851,885,913]},{"l":[[10,1],[43,1],[44,1],[206,1],[372,9],[269,12],[163,15],[337,18],[184,21],[242,24],[349,27],[530,30],[673,33],[406,36],[14,41],[200,46],[12,53],[416,60]],"m":[14,57,63,67,89,91,116,129,156,157,164,173,179,182,184,200,203,206,213,214,231,240,241,242,263,269,276,280,317,337,349,370,371,372,374,398,404,406,411,416,421,427,447,496,523,555,693,707,784],"t":[434,799]},{"l":[[200,1],[10,1],[43,1],[372,1],[82,1],[43,4],[372,7],[82,10],[530,13],[184,16],[163,20],[206,24],[337,28],[349,32],[269,36],[406,42],[14,50],[12,58],[200,66],[416,74]],"m":[14,15,46,57,63,70,89,91,92,104,156,157,164,182,206,207,213,214,216,218,237,240,241,249,263,269,280,317,332,337,371,374,398,40