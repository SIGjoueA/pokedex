{"id":734,"gn":"Pokémon Patrouille","ft":["Avec ses crocs acérés, il ne peut s’empêcher de mordre tout ce qui bouge. Il fut introduit à Alola il y a longtemps, depuis une autre région.","Il furète du matin au soir en quête de nourriture. La nuit, exténué, il tombe comme une brique et s’endort sur place.","Son estomac occupe la plus grande partie de son long corps. Le Dresseur de ce gros mangeur doit prévoir un budget nourriture conséquent.","Il mange de tout, mais aime particulièrement les proies fraîches, voire encore vives. Il erre sur les routes à leur recherche."],"fv":{"27":0,"28":1,"29":2,"30":3},"gr":4,"cr":255,"hc":15,"bh":70,"eg":["Terrestre"],"gw":"medium","gm":{"sv":[0,27],"usum":[0,13],"usum*":[0,13,1,4,2,4,3,4],"sm":[0,13],"sm*":[0,13,1,4,2,4,3,4]},"f":{"734":{"n":"Manglouton","t":["normal"],"s":[48,70,30,30,30,45],"h":0.4,"w":6,"a":[[198,0],[173,0],[91,1]],"av":["sv","usum","sm"],"hi":[[128,5,[27,28,29,30]]],"ls":[{"l":[[33,1],[43,3],[371,7],[28,10],[526,13],[44,19],[189,22],[162,25],[36,28],[184,31],[242,34],[281,37],[37,40],[156,43]],"m":[36,38,91,156,162,164,168,179,182,184,189,201,203,214,240,241,242,263,269,270,283,317,341,369,402,422,423,424,428,523,528,706,707,851,885,886],"e":[283,387,422,423,424]},{"l":[[33,1],[43,3],[228,7],[28,10],[316,13],[117,16],[44,19],[189,22],[162,25],[36,28],[184,31],[242,34],[158,37],[281,40],[37,43],[156,46]],"m":[89,92,104,156,164,168,182,201,207,213,214,216,218,237,259,263,269,317,369,371,496,497,526,590],"e":[279,387,422,423,424],"t":[162,173,231,253,283,351,387,707]},{"l":[[33,1],[43,3],[228,7],[28,10],[316,13],[117,16],[44,19],[189,22],[162,25],[36,28],[184,31],[242,34],[158,37],[281,40],[37,43],[156,46]],"m":[89,92,104,156,164,168,182,201,207,213,214,216,218,237,259,263,269,317,369,371,496,497,526,590],"e":[279,387]}],"lm":{"sv":0,"usum":1,"sm":2},"go":{"a":122,"d":56,"s":134,"m50":994,"m51":1006,"t":["normal"],"bd":1,"fm":["TACKLE_FAST","BITE_FAST"],"cm":["HYPER_FANG","CRUNCH","ROCK_TOMB"],"th":[10000,25],"r"