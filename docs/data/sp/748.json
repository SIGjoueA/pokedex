{"id":748,"gn":"Pokémon Cruel","ft":["Il arpente le fond des océans du haut de ses douze pattes, en laissant derrière lui une traînée de miettes de Corayon.","Son poison provoque chez sa victime des douleurs aiguës pendant trois jours et trois nuits, et laisse des séquelles irréversibles.","Il attaque ses ennemis en projetant des épines empoisonnées, et il utilise ses griffes pour transpercer ceux qui l’approchent de trop près.","Avec ses douze pattes, il crée un dôme protecteur qui lui permet de ne pas subir l’influence des marées.","Pour endurer les températures peu clémentes de Galar, il forme un dôme hermétique avec ses pattes pour conserver sa chaleur corporelle.","Sa poche à venin interne regorge d’un poison si violent que même un Wailord en souffrirait pendant trois jours entiers."],"fv":{"27":0,"28":1,"29":2,"30":3,"33":4,"34":5},"gr":4,"cr":75,"hc":20,"bh":70,"eg":["Aquatique 1"],"gw":"medium","gm":{"sv":[0,345],"swisle":[0,128],"sw":[0,308,1,128],"usum":[0,137],"usum*":[0,137,1,46],"sm":[0,114],"sm*":[0,114,1,46]},"f":{"748":{"n":"Prédastérie","t":["poison","water"],"s":[50,63,152,53,142,35],"h":0.7,"w":14.5,"a":[[196,0],[7,0],[144,1]],"av":["sv","swisle","sw","usum","sm"],"hi":[[222,5,[27,28,29,30]]],"ls":[{"l":[[661,0],[40,1],[44,1],[64,1],[469,1],[474,15],[105,20],[42,25],[390,30],[710,35],[491,42],[398,49],[92,56]],"m":[34,56,57,58,59,63,92,114,156,164,182,184,188,196,203,214,220,240,263,330,334,341,352,390,398,416,441,474,479,482,491,506,679,710,851,861,884,886]},{"l":[[661,0],[661,1],[40,1],[64,1],[469,1],[44,1],[474,15],[105,20],[42,25],[390,30],[710,35],[599,42],[398,49],[92,56]],"m":[42,56,57,58,59,113,156,164,173,182,188,196,203,213,214,219,240,258,263,330,334,341,362,371,390,398,440,441,474,482,496,503,506,599,710]},{"l":[[661,0],[661,1],[40,1],[64,1],[44,1],[390,1],[64,5],[44,9],[390,13],[469,17],[92,21],[474,25],[131,29],[105,33],[398,37],[599,44],[42,51],[710,58]],"m":[57,58,59,92,104,113,156,164,182,188,207,213,214,216,218,219,237,240,258,26