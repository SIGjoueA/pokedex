{"id":450,"gn":"Pokémon Poids Lourd","ft":["Facilement irritable, il ouvre ses mâchoires au maximum pour intimider ses adversaires.","Il exhibe sa force en ouvrant grand sa mâchoire, et attaque en soulevant des tornades de sable.","Il emmagasine du sable qu’il expulse en tornades par les pores de sa peau pour attaquer.","Il prend grand soin des Crabicoque, car ils l’aident à se débarrasser des cailloux qui obstruent parfois les orifices de son corps.","Il entre dans une violente colère quand on l’énerve : il expulse le sable qu’il a accumulé pour provoquer de véritables tempêtes."],"fv":{"17":0,"18":0,"23":1,"24":2,"25":1,"26":2,"33":3,"34":4},"gr":4,"cr":60,"hc":30,"bh":70,"eg":["Terrestre"],"gw":"slow","gm":{"za":[0,119],"sv":[0,266],"la":[0,108],"bdsp":[0,123],"sw":[0,315],"xy":[1,49],"pt":[0,123],"dp":[0,123]},"f":{"450":{"n":"Hippodocus","t":["ground"],"s":[108,112,118,68,72,47],"h":2,"w":300,"a":[[45,0],[159,1]],"pa":[[4,[[45,0]]]],"av":["za","sv","la","bdsp","sw","xy","pt","dp"],"ls":[{"l":[[424,1],[422,1],[281,1],[423,1],[28,1],[33,1],[44,1],[328,12],[91,16],[242,20],[201,24],[36,28],[46,32],[156,38],[89,44],[38,50],[90,56],[303,62]],"m":[34,36,38,46,63,89,91,133,156,157,164,174,182,189,201,203,214,241,242,263,270,304,317,328,330,341,414,416,422,423,424,442,444,446,484,523,667,707,776,815,851,912]},{"l":[[33,1],[156,6],[44,11],[426,18],[242,25],[667,34],[38,43]]},{"l":[[44,1],[424,1],[423,1],[28,1],[33,1],[422,1],[281,1],[328,12],[91,16],[242,20],[201,24],[36,28],[46,32],[156,38],[89,44],[38,50],[90,56],[303,62]],"m":[46,63,70,89,91,104,156,157,164,182,201,203,207,213,214,231,241,249,263,317,352,416,444,446,523]},{"l":[[423,1],[424,1],[422,1],[33,1],[28,1],[44,1],[281,1],[328,12],[91,16],[242,20],[201,24],[36,28],[46,32],[156,38],[89,44],[38,50],[90,56],[303,62]],"m":[34,63,89,91,133,156,157,164,173,182,201,203,213,214,231,241,242,263,276,279,311,317,328,330,341,414,416,422,423,424,442,444,446,484,496,523,667,707,776],"t":[815]},{"l":[[423,1],[424,1],[422,1]