{"id":667,"gn":"Pokémon Lionceau","ft":["Plus l’adversaire auquel il est confronté est fort, plus la température de sa crinière augmente, l’énergie générée se diffusant alors dans tout son corps.","Il n’hésite pas à quitter la horde et à mener une existence solitaire pour mieux pouvoir s’entraîner. Il a le sang chaud et ne rechigne pas au combat.","Il est élevé avec ses congénères au sein de la troupe, mais dès qu’il peut chasser seul, il doit partir et vivre par ses propres moyens.","Il déborde d’énergie et de curiosité. Quand il se fâche ou qu’il s’apprête à se battre, sa courte crinière s’échauffe."],"fv":{"23":0,"24":1,"25":0,"26":1,"29":2,"30":3},"gr":7,"cr":220,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"medium-slow","gm":{"za":[0,45],"svdisk":[0,36],"sv":[0,224],"usum":[0,370],"usum*":[3,117],"xy":[0,57]},"f":{"667":{"n":"Hélionceau","t":["fire","normal"],"s":[62,50,58,73,54,72],"h":0.6,"w":13.5,"a":[[79,0],[127,0],[153,1]],"av":["za","svdisk","sv","usum","xy"],"ls":[{"l":[[33,1],[43,1],[52,5],[526,8],[29,11],[568,15],[36,20],[424,23],[283,28],[497,33],[53,36],[242,39],[304,43],[510,46],[315,50]],"m":[34,36,38,46,53,76,83,91,126,129,156,164,168,182,189,203,214,240,241,242,257,261,263,269,270,283,304,315,394,422,424,488,512,523,528,555,706,851,885],"e":[83,281,394,494]},{"l":[[33,1],[43,1],[52,5],[526,8],[29,11],[568,15],[36,20],[424,23],[283,28],[497,33],[53,36],[242,39],[304,43],[510,46],[315,50]],"m":[46,53,76,92,104,126,156,164,168,182,207,213,214,216,218,237,240,241,261,263,269,315,371,399,488,496,497,523,526,528,555,590],"e":[83,281,289,394,494],"t":[173,231,257,270,283,289,304]},{"l":[[33,1],[43,1],[52,5],[526,8],[29,11],[568,15],[36,20],[424,23],[283,28],[497,33],[53,36],[242,39],[304,43],[510,46],[315,50]],"m":[46,53,70,76,91,92,104,126,156,164,168,182,207,213,214,216,218,237,240,241,249,261,263,269,315,371,399,488,496,497,510,514,523,528,555,590],"e":[83,281,289,494]}],"lm":{"svdisk":0,"sv":0,"usum":1,"xy":2},"go":{"a":139,"d":112,"s":158,"m50":1611,"m5