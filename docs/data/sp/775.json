{"id":775,"gn":"Pokémon Rêveur","ft":["Il rejoint et quitte ce monde en dormant. Son existence se déroule comme un rêve paisible. Il dort du sommeil du juste toute sa vie durant.","La bûche qu’il tient est un cadeau de naissance de ses parents. S’il est bien apprivoisé, il s’accrochera au bras de son Dresseur.","Il dort continuellement depuis sa naissance. Lorsqu’il est en phase de sommeil profond, il ne bouge plus d’un poil.","Ce Pokémon passe sa vie entière à dormir à cause des composants anesthésiants qui se trouvent dans les feuilles qu’il mange."],"fv":{"27":0,"28":1,"29":2,"30":3},"gr":4,"cr":45,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"slow","gm":{"sv":[0,315],"usum":[0,286],"usum*":[2,107],"sm":[0,222],"sm*":[2,94]},"f":{"775":{"n":"Dodoala","t":["normal"],"s":[65,115,65,75,95,65],"h":0.4,"w":19.9,"a":[[213,0]],"av":["sv","usum","sm"],"ls":[{"l":[[111,1],[205,1],[254,6],[255,6],[256,6],[229,11],[281,16],[21,21],[175,26],[389,31],[244,36],[452,41],[37,46]],"m":[14,34,36,38,63,67,89,157,162,164,168,174,179,182,203,204,214,232,240,241,244,263,280,282,283,317,339,347,369,374,402,416,421,428,441,442,490,512,523,583,707,851,861,885],"e":[47,204,273,276,583]},{"l":[[111,1],[205,1],[254,6],[255,6],[256,6],[229,11],[281,16],[21,21],[175,26],[389,31],[244,36],[452,41],[37,46]],"m":[14,89,92,104,157,164,182,207,213,214,216,218,237,241,244,263,280,339,347,369,371,421,490,496,511,512,523,526,590],"e":[47,204,273,583],"t":[173,276,282,283,387,428,442,707]},{"l":[[111,1],[205,1],[254,6],[255,6],[256,6],[229,11],[281,16],[21,21],[175,26],[389,31],[244,36],[452,41],[37,46]],"m":[14,89,92,104,157,164,182,207,213,214,216,218,237,241,244,263,280,339,347,369,371,421,490,496,511,512,523,526,590],"e":[47,204,273,583]}],"lm":{"sv":0,"usum":1,"sm":2},"go":{"a":216,"d":165,"s":163,"m50":2919,"m51":2954,"t":["normal"],"bd":3,"fm":["ROLLOUT_FAST","YAWN_FAST"],"cm":["PLAY_ROUGH","BULLDOZE","PAYBACK"],"th":[50000,50],"r":1,"sh":["wild","research","photobomb"]},"en":{"sm":[[183,4,24,27,10]