{"id":528,"gn":"Pokémon Cupidon","ft":["Il émet des ondes sonores de différentes fréquences par le nez. Certaines peuvent briser des rochers.","Le mâle courtise la femelle à l’aide d’ultrasons. Les écouter met de très bonne humeur.","Sa queue s’agite frénétiquement quand il émet ses ultrasons assez puissants pour pulvériser du béton.","Émettre des ondes sonores ultra-puissantes le fatigue tellement qu’il n’a plus de forces pour voler.","Certaines contrées le vénèrent et pensent que la forme de son nez est un symbole de chance et de bonheur."],"fv":{"17":0,"18":1,"23":2,"24":1,"25":2,"26":1,"33":3,"34":4},"tt":["Il agite vigoureusement sa queue lorsqu'il émet des ondes ultrasonores assez fortes pour réduire le béton en décombres."],"tv":{"21":0,"22":0},"gr":4,"cr":45,"hc":15,"bh":70,"eg":["Aérien","Terrestre"],"gw":"medium","gm":{"swisle":[0,152],"sw":[0,175],"xy":[1,56],"b2w2":[0,67],"bw":[0,34]},"f":{"528":{"n":"Rhinolove","t":["psychic","flying"],"s":[67,57,55,77,55,114],"h":0.9,"w":10.5,"a":[[109,0],[103,0],[86,1]],"av":["swisle","sw","xy","b2w2","bw"],"ls":[{"l":[[16,1],[213,1],[93,1],[283,1],[314,15],[286,20],[372,25],[133,30],[403,35],[94,40],[347,45],[248,50],[493,55]],"m":[19,63,86,94,113,115,129,133,156,164,168,173,182,202,203,204,211,213,214,219,226,240,247,248,253,257,263,269,270,271,285,286,313,347,360,369,372,403,412,416,417,427,428,433,473,496,500,502,512,599,683,706],"t":[797,814]},{"l":[[93,1],[316,1],[16,1],[372,1],[316,4],[16,8],[372,12],[531,15],[286,19],[314,21],[213,25],[133,29],[347,29],[403,32],[248,36],[94,41],[283,47]],"m":[19,63,86,92,94,104,113,115,138,148,156,164,168,182,207,211,213,214,216,218,219,237,240,244,247,259,263,269,332,347,355,360,369,373,412,416,433,451,473,496,512,590]},{"l":[[93,1],[316,1],[16,1],[372,1],[316,4],[16,8],[372,12],[531,15],[286,19],[314,21],[213,25],[133,29],[347,29],[403,32],[248,36],[94,41],[283,47]],"m":[19,63,86,92,94,104,113,115,138,148,156,164,168,182,207,213,216,218,219,237,240,244,247,259,263,269,332,34