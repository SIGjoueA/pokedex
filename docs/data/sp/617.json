{"id":617,"gn":"Pokémon Exuviateur","ft":["Quand son corps s’assèche, il faiblit. Il s’en prémunit en s’enroulant dans plusieurs couches d’une fine muqueuse.","Il s’est bien allégé en se débarrassant de sa lourde carapace. Il se bat avec l’agilité d’un ninja.","Il se bat avec célérité en projetant du poison. Il est si cool qu’il est souvent le héros de films ou de bandes dessinées à succès.","Il est bien plus agile sans sa coquille. La membrane en forme de bandelettes qui l’entoure l’empêche de se dessécher."],"fv":{"17":0,"18":1,"23":1,"24":0,"25":1,"26":0,"33":2,"34":3},"tt":["Quand Learne sèche, il s'affaiblit. Il enveloppe donc une membrane autour d'elle-même pour la protéger pendant qu'il crache du poison."],"tv":{"21":0,"22":0},"gr":4,"cr":75,"hc":15,"bh":70,"eg":["Insectoïde"],"gw":"medium","gm":{"swcrown":[0,98],"swisle":[0,65],"sw":[0,276],"xy":[2,25],"b2w2":[0,158],"bw":[0,123]},"f":{"617":{"n":"Limaspeed","t":["bug"],"s":[80,70,40,100,60,145],"h":0.8,"w":25.3,"a":[[93,0],[60,0],[84,1]],"av":["swcrown","swisle","sw","xy","b2w2","bw"],"ls":[{"l":[[594,1],[51,1],[174,1],[281,1],[151,1],[385,1],[34,1],[71,1],[104,1],[491,1],[98,1],[72,12],[522,16],[129,20],[97,24],[202,28],[384,32],[369,36],[105,40],[405,44],[515,48],[92,52]],"m":[34,63,97,129,141,156,164,173,179,182,188,191,201,202,203,213,214,226,227,240,263,341,369,384,385,390,405,409,411,412,416,474,496,599],"t":[806]},{"l":[[515,1],[384,1],[141,1],[491,1],[104,1],[98,1],[491,4],[104,8],[98,13],[522,16],[72,20],[129,25],[382,28],[97,32],[202,37],[369,40],[405,44],[105,49],[384,52],[515,56]],"m":[63,92,104,156,164,182,188,201,207,213,214,216,218,237,240,263,369,411,412,416,474,496,522,590,611]},{"l":[[141,1],[491,1],[104,1],[98,1],[491,4],[104,8],[98,13],[522,16],[72,20],[129,25],[382,28],[97,32],[202,37],[369,40],[405,44],[105,49],[384,52],[515,56]],"m":[63,92,104,156,164,182,188,201,207,213,216,218,237,240,263,369,411,412,416,474,496,522],"t":[173,202,214,282,324,380,450]},{"l":[[141,1],[491,1],[104,1],[