{"id":686,"gn":"Pokémon Rotation","ft":["Éblouis par les points lumineux qui clignotent sur son corps, les ennemis perdent toute envie de se battre.","Il ébranle le moral des ennemis lui cherchant noise grâce aux clignotements qu’il émet. Il profite de cette diversion pour se cacher.","Il attire ses proies en faisant clignoter son corps, puis les immobilise en les enserrant de ses longs tentacules.","Il fait clignoter ses points lumineux à différentes fréquences pour échanger des informations avec ses congénères.","Il fait clignoter son corps lumineux en tournoyant. Il communique avec ses congénères à l’aide de signaux de lumière.","Il sape la combativité de son adversaire en faisant clignoter son corps lumineux, puis profite de cet instant de répit pour s’enfuir."],"fv":{"23":0,"24":1,"25":0,"26":1,"29":2,"30":3,"33":4,"34":5},"gr":4,"cr":190,"hc":20,"bh":70,"eg":["Aquatique 1","Aquatique 2"],"gw":"medium","gm":{"za":[0,159],"svdisk":[0,80],"sv":[2,80],"swisle":[0,108],"sw":[0,290,1,108],"usum":[0,26],"usum*":[0,26,3,10],"xy":[1,10]},"f":{"686":{"n":"Sepiatop","t":["dark","psychic"],"s":[53,54,53,37,46,45],"h":0.4,"w":3.5,"a":[[126,0],[21,0],[151,1]],"av":["za","svdisk","sv","swisle","sw","usum","xy"],"ls":[{"l":[[33,1],[64,1],[95,3],[35,6],[371,9],[365,12],[60,15],[207,18],[163,21],[400,24],[427,27],[415,31],[492,33],[576,36],[276,39]],"m":[53,60,85,94,113,115,129,156,157,164,168,180,182,203,214,226,240,241,244,248,263,269,270,271,282,285,313,332,347,356,374,399,417,433,473,492,500,679,710,797,808,851],"e":[50,194,367]},{"l":[[64,1],[33,1],[95,3],[35,6],[371,9],[365,12],[60,15],[207,18],[163,21],[400,24],[427,27],[415,31],[492,33],[576,36],[276,39]],"m":[53,85,94,113,115,156,157,164,168,173,182,203,213,214,226,240,241,248,263,269,276,313,347,371,374,385,399,417,427,433,492,496,500,502,514,710],"e":[50,194,367],"t":[797,808]},{"l":[[33,1],[64,1],[132,1],[115,4],[492,8],[207,12],[149,13],[576,15],[95,18],[60,21],[415,23],[371,27],[113,31],[365,35],[427,39],[163,43],