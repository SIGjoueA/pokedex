{"id":195,"gn":"Pokémon Poisson","ft":["De nature placide, il a tendance à se cogner la tête contre les récifs et autres bateaux de passage.","C’est un grand paresseux qui attend au fond de la rivière qu’une proie lui tombe dans le bec.","Ce Pokémon est très insouciant. Quand il nage, il fonce tête la première dans la coque des bateaux.","Maraiste trouve sa nourriture en laissant sa bouche ouverte dans l’eau, et attend que ses proies y pénètrent sans faire attention. Comme ce Pokémon est inactif, il n’a jamais très faim.","Il a tendance à se cogner la tête contre la coque des navires et les rochers, mais, imperturbable, il continue de nager comme si de rien n’était.","Il est toujours gluant. Quand il nage, il se cogne souvent la tête au fond des rivières, mais semble s’en moquer."],"fv":{"17":0,"18":0,"23":1,"24":2,"25":3,"26":3,"33":4,"34":5},"gr":4,"cr":90,"hc":20,"bh":70,"eg":["Aquatique 1","Terrestre"],"gw":"medium","gm":{"svmask":[0,6],"sv":[1,6],"bdsp":[0,118],"swisle":[0,59],"sw":[0,101,1,59],"xy":[2,18],"hgss":[0,57],"pt":[0,118],"dp":[0,118],"c":[0,57],"gs":[0,57]},"f":{"195":{"n":"Maraiste","t":["water","ground"],"s":[95,85,85,65,65,35],"h":1.4,"w":75,"a":[[6,0],[11,0],[109,1]],"pa":[[4,[[6,0],[11,0]]]],"av":["svmask","sv","bdsp","swisle","sw","xy","hgss","pt","dp","c","gs"],"ls":[{"l":[[39,1],[55,1],[240,1],[341,1],[54,12],[114,12],[21,16],[281,23],[401,28],[330,34],[133,40],[92,46],[89,52]],"m":[8,34,36,38,56,57,58,59,63,89,91,92,114,127,133,156,157,164,168,174,182,188,189,191,196,201,203,214,227,240,250,263,264,270,280,317,330,341,352,374,390,409,411,414,416,419,444,446,482,491,523,598,667,707,710,776,851,883,885,886]},{"l":[[341,1],[240,1],[39,1],[55,1],[114,12],[54,12],[21,16],[281,23],[401,28],[330,34],[133,40],[92,46],[89,52]],"m":[57,58,59,63,70,89,91,92,104,127,148,156,157,164,168,182,188,201,203,207,213,214,219,231,240,249,258,263,264,280,317,352,374,411,416,444,503,523]},{"l":[[55,1],[39,1],[240,1],[341,1],[54,12],[114,12],[21,16],[281,23],[401,