{"id":773,"gn":"Pokémon Multigénome","ft":["La confiance qu’il place en son Dresseur a réveillé ses pouvoirs. Il est à présent capable de changer de type à loisir durant le combat.","Son nom lui a été donné par le jeune homme qui a le premier réussi à faire évoluer Type:0.","Il a réveillé tout son potentiel et a évolué. Briser son lourd masque a décuplé sa vitesse.","Il a réussi à briser son masque grâce à la force mentale qu’il a acquise en établissant un lien puissant avec son Dresseur.","Un lien fort avec son Dresseur lui a permis de libérer tout son potentiel. Il peut changer de type à volonté.","La relation de confiance qui le lie à son Dresseur est le facteur décisif qui lui permet de libérer tout son potentiel."],"fv":{"27":0,"28":1,"29":2,"30":3,"33":4,"34":5},"gr":-1,"cr":3,"hc":120,"bh":0,"eg":["Inconnu"],"gw":"slow","gm":{"sw":[0,382],"usum":[0,260],"sm":[0,204]},"f":{"773":{"n":"Silvallié","t":["normal"],"s":[95,95,95,95,95,95],"h":2.3,"w":100.5,"a":[[225,0]],"av":["sw","usum","sm"],"ls":[{"l":[[718,0],[718,1],[153,1],[422,1],[423,1],[424,1],[305,1],[286,1],[442,1],[33,1],[44,1],[332,1],[184,1],[458,15],[319,20],[306,25],[403,30],[161,35],[404,40],[242,45],[36,50],[38,55],[575,60]],"m":[14,53,57,58,63,85,86,120,129,156,157,161,164,173,179,182,184,196,200,201,203,211,214,240,241,242,247,257,258,263,286,304,334,337,369,371,403,404,416,421,422,423,424,428,430,442,496,526,555,706],"t":[434,518,519,520,796,805]},{"l":[[718,0],[718,1],[377,1],[286,1],[442,1],[305,1],[424,1],[423,1],[422,1],[33,1],[99,5],[228,10],[44,15],[332,20],[306,25],[184,30],[404,35],[36,40],[319,45],[242,50],[458,55],[403,60],[386,65],[13,70],[161,75],[38,80],[575,85]],"m":[14,46,53,57,58,63,85,86,92,104,153,156,157,164,182,201,207,211,214,216,218,237,240,241,247,258,263,332,337,369,371,404,416,421,430,488,496,526,555,590],"t":[173,196,200,257,277,304,324,334,366,387,428,432,434,442,518,519,520,673]},{"l":[[718,0],[718,1],[377,1],[286,1],[442,1],[305,1],[424,1],[423,1],[422,1],[33,1],[99