{"id":677,"gn":"Pokémon Retenue","ft":["Il couvre la source de ses pouvoirs psychiques hors du commun avec ses oreilles afin d’éviter les accidents.","Il a quelques difficultés à contrôler son pouvoir psychique. Grâce à celui-ci, il peut projeter en l’air tous les objets dans un rayon de 100 m.","Sous son masque inexpressif, il est en fait constamment en train d’essayer de contenir ses puissants pouvoirs psychiques.","Il possède des pouvoirs psychiques si puissants qu’il peut faire valser un catcheur. Malheureusement, il a du mal à les contrôler."],"fv":{"23":0,"24":1,"25":0,"26":1,"33":2,"34":3},"gr":4,"cr":190,"hc":20,"bh":70,"eg":["Terrestre"],"gw":"medium","gm":{"za":[0,43],"svdisk":[0,104],"sw":[0,208],"xy":[0,114]},"f":{"677":{"n":"Psystigri","t":["psychic"],"s":[62,48,54,63,60,68],"h":0.3,"w":3.5,"a":[[51,0],[151,0],[20,1]],"av":["za","svdisk","sw","xy"],"ls":[{"l":[[10,1],[43,1],[252,3],[574,6],[93,9],[343,18],[60,21],[113,30],[115,30],[473,33]],"m":[60,85,86,94,113,115,129,156,164,182,203,204,214,240,241,244,247,263,270,271,285,313,347,356,399,412,417,428,433,451,473,574,583,797,851,917],"e":[281,321]},{"l":[[10,1],[43,1],[252,3],[574,6],[93,9],[343,18],[60,21],[113,30],[115,30],[473,33]],"m":[6,85,86,94,113,115,129,156,164,173,182,203,213,214,219,231,240,241,263,270,271,285,313,347,371,399,412,417,428,433,472,473,478,496,502,526,583],"e":[281,321],"t":[797]},{"l":[[10,1],[43,1],[343,5],[93,9],[113,13],[60,17],[252,19],[574,22],[473,25]],"m":[15,85,86,92,94,104,113,115,138,148,156,164,182,207,213,214,216,218,219,237,240,241,244,259,263,347,371,399,412,433,451,473,496,497,590],"e":[112,271,274,281]}],"lm":{"svdisk":0,"sw":1,"xy":2},"go":{"a":120,"d":114,"s":158,"m50":1424,"m51":1441,"t":["psychic"],"bd":3,"fm":["CONFUSION_FAST","SCRATCH_FAST"],"cm":["PSYSHOCK","ENERGY_BALL","PSYCHIC"],"th":[50000,50],"r":1,"sh":["wild","raid","research","photobomb"]},"en":{"xy":[[570,27,11,12,20],[702,4,30,30,33]],"sw":[[353,4,26,28,35],[353,4,60,60,35,[1]],[382,4,28,30,100]